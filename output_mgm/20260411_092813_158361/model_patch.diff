-def is_concrete_inheritance(field):
-    """
-    Check if a field represents concrete (multi-table) inheritance.
-    
-    In Django, when a model extends a non-abstract parent model without
-    specifying abstract=True, Django creates an implicit one-to-one relationship
-    from the child model to the parent model. This is called concrete inheritance.
-    
-    Args:
-        field: A Django field object to analyze
-        
-    Returns:
-        bool: True if the field represents concrete inheritance, False otherwise
