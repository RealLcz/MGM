nes.append(f"Field Analysis Results for {module_path}.{model_name}.{field_name}")\n        lines.append("=" * 60)\n        \n        for key, value in result.items():\n            lines.append(f"{key}: {value}")\n        \n        return "\\n".join(lines)\n        \n    except Exception as e:\n        return f"Error analyzing field: {str(e)}"\n\n\nif __name__ == "__main__":\n    # Example usage\n    import json\n    import sys\n    \n    # Check if the script is called with arguments\n    if len(sys.argv) < 4:\n        print("Usage: python django_field_semantics.py <module_path> <model_name> <field_name>")\n        print("Example: python django_field_semantics.py myapp.models MyModel my_field")\n        sys.exit(1)\n    \n    module_path = sys.argv[1]\n    model_name = sys.argv[2]\n    field_name = sys.argv[3]\n    \n    result = tool_function(module_path, model_name, field_name)\n    print(result)\n'}
