-    # Check if this is a OneToOneField
-    if field.get_internal_type() != "OneToOneField":
-        return False
-    
-    # Check if this field is automatically created by Django for concrete inheritance
-    # Django creates a one-to-one field named after the parent model's lowercase name
-    # when concrete inheritance is used
-    
-    # For concrete inheritance, the field typically:
-    # 1. Is a OneToOneField
-    # 2. Points to the parent model in the inheritance chain
-    # 3. Is used to link the child table to the parent table
-    
-    # We can check if this field is the automatic one created for inheritance
-    # by checking if it's the primary key or if it links to a model that is
-    # in the inheritance chain
-    
-    try:
-        # Check if the field's related model has this model in its inheritance chain
-        related_model = field.remote_field.model
-        if related_model:
-            # Check if this model has the related model as an ancestor
-            if hasattr(related_model, '_meta'):
-                # Get all ancestors of this model
-                all_ancestors = []
-                for parent in related_model._meta.get_parent_list():
-                    all_ancestors.append(parent)
-                    all_ancestors.extend(parent._meta.get_parent_list())
-                
-                # If this model is in the ancestors list, this is likely concrete inheritance
-                if field.model in all_ancestors:
-                    return True
-    except Exception:
-        # If we can't determine, return False
-        pass
-    
-    return False
