+# This file is adapted from https://github.com/jennyzzt/dgm.
+
+import sys
+from utils.test_runner import run_tests, discover_tests, format_test_output_for_agent
+
+
+def tool_info():
+    return {
+        "name": "run_tests",
+        "description": """Run tests to validate code changes.
+Use this tool to:
+1. Run all tests to establish a baseline before making changes
+2. Run specific test files after making code changes to verify fixes
+3. Identify which tests are failing and why
+
+The tool returns a success status and detailed test output. Use this information to
+understand the current state of the code and validate that your changes fix the issues.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "test_files": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Optional list of test files to run. If not provided, all tests will be discovered and run."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Timeout for the test run in seconds. Default is 300 seconds.",
+                    "default": 300
+                }
+            },
+            "required": [],
+        },
+    }
+
+
+def tool_function(test_files=None, timeout=300):
+    """
+    Run tests and return the results.
+    
+    Args:
+        test_files: Optional list of test files to run. If None, discover tests automatically.
+                    Can be either file paths or import paths (e.g., 'tests.test_edit_tool').
+        timeout: Timeout for the test run in seconds.
+    
+    Returns:
+        str: A formatted string containing test results, including success status and output.
+    """
+    success, output = run_tests(test_files=test_files, timeout=timeout)
+    
+    # Format the output for the agent
+    formatted_output = format_test_output_for_agent(output)
+    
+    # Create a structured result
+    result = f"Test Results:\n"
+    result += f"Status: {'SUCCESS' if success else 'FAILURE'}\n"
+    result += f"Output:\n{formatted_output}"
+    
+    return result
+
+
+if __name__ == "__main__":
+    # Example usage
+    import sys
+    import json
+    
+    # Check if the script is called with arguments
+    if len(sys.argv) < 2:
+        # Run all tests
+        result = tool_function()
+        print(result)
+    else:
+        # Parse test files from command line
+        test_files = sys.argv[1:]
+        result = tool_function(test_files=test_files)
+        print(result)
