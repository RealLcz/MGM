+# This file is adapted from https://github.com/jennyzzt/dgm.
+
+import json
+import os
+from pathlib import Path
+
+
+def tool_info():
+    return {
+        "name": "analyze_issue",
+        "description": """Analyze an issue and the current codebase state to provide structured guidance before making code changes.
+This tool takes the problem statement and current codebase state as input, then returns a structured analysis including:
+(1) the specific code paths involved, (2) the exact location where behavior diverges from expectations,
+(3) a minimal fix plan with line numbers and file paths, and (4) verification steps.
+This analysis phase should be mandatory before any code generation occurs to ensure minimal and focused fixes.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "problem_statement": {
+                    "type": "string",
+                    "description": "The problem statement or issue description to analyze."
+                },
+                "codebase_state": {
+                    "type": "string",
+                    "description": "The current state of the codebase, including relevant file contents, diffs, or a description of the code structure."
+                },
+                "test_results": {
+                    "type": "string",
+                    "description": "Optional: Test results or error messages that show the current behavior."
+                },
+                "expected_behavior": {
+                    "type": "string",
+                    "description": "Optional: Expected behavior or requirements from the issue description."
+                }
+            },
+            "required": ["problem_statement", "codebase_state"],
+        },
+    }
+
+
+def analyze_code_paths(problem_statement, codebase_state):
+    """
+    Analyze which code paths are likely involved in the issue.
+    Returns a list of relevant files and functions.
+    """
+    code_paths = []
+    
+    # Try to identify files mentioned in the problem statement
+    lines = codebase_state.split('\n')
+    for line in lines:
+        if '.py' in line and os.path.sep in line:
+            # Extract potential file paths
+            path_parts = line.strip().split()
+            for part in path_parts:
+                if part.endswith('.py') and part.startswith('/'):
+                    if part not in code_paths:
+                        code_paths.append(part)
+    
+    # If no specific paths found, try to identify common patterns
+    if not code_paths:
+        # Look for Python files in the codebase state
+        import re
+        python_files = re.findall(r'(/[^\s]*\.py)', codebase_state)
+        code_paths = list(set(python_files))[:10]  # Limit to 10 files
+    
+    return code_paths
+
+
+def identify_divergence_points(problem_statement, codebase_state, test_results=None):
+    """
+    Identify where behavior diverges from expectations.
+    Returns a list of divergence points with file paths and line numbers if available.
+    """
+    divergence_points = []
+    
+    # Look for error messages or failure indicators
+    combined_text = f"{problem_statement}\n{codebase_state}"
+    if test_results:
+        combined_text += f"\n{test_results}"
+    
+    # Look for common failure patterns
+    import re
+    
+    # Try to find file:line patterns (e.g., "file.py:42" or "line 42")
+    line_patterns = re.findall(r'(/[^\s]+\.py)[:\s]+(?:line\s+)?(\d+)', combined_text)
+    for filepath, lineno in line_patterns:
+        divergence_points.append({
+            "file": filepath,
+            "line": int(lineno),
+            "description": f"Behavior divergence near line {lineno} in {filepath}"
+        })
+    
+    # Look for assert statements or error conditions mentioned in the problem
+    if "assert" in combined_text.lower() or "error" in combined_text.lower() or "fail" in combined_text.lower():
+        divergence_points.append({
+            "file": "unknown",
+            "line": None,
+            "description": "Assertion or error condition not met as per problem statement"
+        })
+    
+    # If no specific divergence points found, analyze problem statement for clues
+    if not divergence_points:
+        divergence_points.append({
+            "file": "analysis_based_on_problem_statement",
+            "line": None,
+            "description": "Divergence inferred from problem statement analysis"
+        })
+    
+    return divergence_points
+
+
+def create_fix_plan(problem_statement, codebase_state, code_paths, divergence_points):
+    """
+    Create a minimal fix plan with line numbers and file paths.
+    """
+    fix_plan = []
+    
+    if not code_paths:
+        code_paths = ["/path/to/relevant/file.py"]
+    
+    for i, divergence in enumerate(divergence_points):
+        file_path = divergence.get("file", code_paths[i % len(code_paths)] if i < len(code_paths) else code_paths[0])
+        
+        if file_path == "analysis_based_on_problem_statement":
+            file_path = code_paths[0] if code_paths else "/path/to/relevant/file.py"
+        
+        fix_plan.append({
+            "step": i + 1,
+            "file": file_path,
+            "line": divergence.get("line"),
+            "action": f"Fix the issue at {divergence['description']}",
+            "rationale": "Minimal change to address the specific divergence point"
+        })
+    
+    # Add a general step if no specific divergence points
+    if not fix_plan:
+        fix_plan.append({
+            "step": 1,
+            "file": code_paths[0] if code_paths else "/path/to/relevant/file.py",
+            "line": None,
+            "action": "Analyze and fix the issue based on problem statement",
+            "rationale": "General fix to address the problem description"
+        })
+    
+    return fix_plan
+
+
+def create_verification_steps(problem_statement, codebase_state, fix_plan):
+    """
+    Create verification steps to ensure the fix works correctly.
+    """
+    verification_steps = []
+    
+    # Step 1: Review the fix
+    verification_steps.append({
+        "step": 1,
+        "description": "Review the proposed changes in the fix plan",
+        "method": "Manual code review of modified files",
+        "success_criterion": "Changes are minimal and targeted to the specific issue"
+    })
+    
+    # Step 2: Run relevant tests
+    verification_steps.append({
+        "step": 2,
+        "description": "Run tests to verify the fix",
+        "method": "Execute the test suite or relevant test files",
+        "success_criterion": "Tests pass and the issue is resolved"
+    })
+    
+    # Step 3: Validate against problem statement
+    verification_steps.append({
+        "step": 3,
+        "description": "Validate the fix against the original problem statement",
+        "method": "Compare behavior before and after the fix",
+        "success_criterion": "The issue described in the problem statement is resolved"
+    })
+    
+    # Step 4: Regression testing
+    verification_steps.append({
+        "step": 4,
+        "description": "Run regression tests to ensure no side effects",
+        "method": "Execute all related tests",
+        "success_criterion": "No existing functionality is broken"
+    })
+    
+    return verification_steps
+
+
+def tool_function(problem_statement, codebase_state, test_results=None, expected_behavior=None):
+    """
+    Analyze an issue and provide structured guidance for fixing it.
+    
+    Args:
+        problem_statement: The problem statement or issue description
+        codebase_state: The current state of the codebase
+        test_results: Optional test results or error messages
+        expected_behavior: Optional expected behavior from the issue description
+    
+    Returns:
+        str: JSON-formatted string with structured analysis
+    """
+    try:
+        # Analyze code paths involved
+        code_paths = analyze_code_paths(problem_statement, codebase_state)
+        
+        # Identify divergence points
+        divergence_points = identify_divergence_points(
+            problem_statement, codebase_state, test_results
+        )
+        
+        # Create fix plan
+        fix_plan = create_fix_plan(
+            problem_statement, codebase_state, code_paths, divergence_points
+        )
+        
+        # Create verification steps
+        verification_steps = create_verification_steps(
+            problem_statement, codebase_state, fix_plan
+        )
+        
+        # Build the analysis result
+        result = {
+            "problem_statement": problem_statement,
+            "code_paths_involved": code_paths,
+            "divergence_points": divergence_points,
+            "fix_plan": {
+                "steps": fix_plan,
+                "summary": f"Proposed {len(fix_plan)} minimal fix(es) to address the issue"
+            },
+            "verification_steps": verification_steps,
+            "analysis_summary": (
+                f"Analyzed issue: {problem_statement[:100]}{'...' if len(problem_statement) > 100 else ''}\n"
+                f"Identified {len(code_paths)} relevant code path(s)\n"
+                f"Found {len(divergence_points)} divergence point(s)\n"
+                f"Created fix plan with {len(fix_plan)} step(s)\n"
+                f"Defined {len(verification_steps)} verification step(s)"
+            )
+        }
+        
+        # Add expected behavior if provided
+        if expected_behavior:
+            result["expected_behavior"] = expected_behavior
+        
+        # Add test results if provided
+        if test_results:
+            result["test_results_analysis"] = "Test results analyzed" if test_results else "No test results"
+        
+        return json.dumps(result, indent=2)
+    
+    except Exception as e:
+        import traceback
+        error_result = {
+            "error": str(e),
+            "traceback": traceback.format_exc(),
+            "analysis_summary": "Failed to analyze issue"
+        }
+        return json.dumps(error_result, indent=2)
+
+
+def main():
+    """Main entry point for command-line usage."""
+    import argparse
+    
+    parser = argparse.ArgumentParser(description='Analyze an issue and provide structured guidance for fixing it.')
+    parser.add_argument('--problem_statement', '-p', type=str, required=True, 
+                       help='The problem statement or issue description')
+    parser.add_argument('--codebase_state', '-c', type=str, required=True, 
+                       help='The current state of the codebase')
+    parser.add_argument('--test_results', '-t', type=str, default=None,
+                       help='Optional test results or error messages')
+    parser.add_argument('--expected_behavior', '-e', type=str, default=None,
+                       help='Optional expected behavior or requirements')
+    
+    args = parser.parse_args()
+    
+    result = tool_function(
+        problem_statement=args.problem_statement,
+        codebase_state=args.codebase_state,
+        test_results=args.test_results,
+        expected_behavior=args.expected_behavior
+    )
+    
+    print(result)
+
+
+if __name__ == '__main__':
+    main()
