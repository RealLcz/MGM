+# This file implements the requirement_validator tool.
+# It analyzes issue descriptions and proposed solutions to validate that
+# each proposed code change can be traced to specific requirements.
+
+import re
+import json
+from typing import Dict, List, Any
+
+
+def tool_info():
+    """
+    Returns metadata about the requirement_validator tool.
+    """
+    return {
+        "name": "requirement_validator",
+        "description": """Analyzes issue descriptions and proposed solutions to validate that each proposed code change can be traced to specific requirements.
+        
+This tool:
+1. Parses the issue to extract key requirements
+2. Analyzes the proposed patch to identify all changed files and their purposes
+3. Creates a mapping showing which requirements each change addresses
+4. Flags any changes without clear requirement links or missing requirement coverage
+
+Use this tool to validate that your proposed code changes fully address the issue requirements before finalizing output.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "issue_description": {
+                    "type": "string",
+                    "description": "The issue description that outlines the requirements to be addressed."
+                },
+                "proposed_solution": {
+                    "type": "string",
+                    "description": "The proposed solution draft or code changes to be validated against the requirements."
+                }
+            },
+            "required": ["issue_description", "proposed_solution"]
+        }
+    }
+
+
+def extract_requirements(issue_description: str) -> List[Dict[str, Any]]:
+    """
+    Extract key requirements from the issue description.
+    
+    Args:
+        issue_description: The issue description text
+        
+    Returns:
+        List of dictionaries containing extracted requirements
+    """
+    requirements = []
+    
+    # Look for numbered or bulleted requirements
+    lines = issue_description.split('\n')
+    current_req = None
+    
+    for line in lines:
+        line = line.strip()
+        if not line:
+            continue
+            
+        # Check for numbered requirements (e.g., "1. ", "1) ", "1.")
+        number_match = re.match(r'^(\d+)[.\)]\s*(.+)$', line)
+        if number_match:
+            if current_req:
+                requirements.append(current_req)
+            current_req = {
+                'id': int(number_match.group(1)),
+                'text': number_match.group(2).strip(),
+                'keywords': []
+            }
+            # Extract keywords from the requirement
+            words = current_req['text'].lower().split()
+            # Filter out common words
+            stop_words = {'the', 'a', 'an', 'and', 'or', 'but', 'in', 'on', 'at', 'to', 'for', 'of', 'with', 'by'}
+            current_req['keywords'] = [w for w in words if w not in stop_words]
+        elif current_req and line.startswith('-') or line.startswith('*'):
+            # Check for bullet points under a requirement
+            bullet_text = line[1:].strip()
+            current_req['text'] += ' ' + bullet_text
+            words = bullet_text.lower().split()
+            stop_words = {'the', 'a', 'an', 'and', 'or', 'but', 'in', 'on', 'at', 'to', 'for', 'of', 'with', 'by'}
+            current_req['keywords'].extend([w for w in words if w not in stop_words])
+        elif current_req:
+            # Continue appending to current requirement
+            current_req['text'] += ' ' + line
+    
+    if current_req:
+        requirements.append(current_req)
+    
+    # If no numbered requirements found, try to extract requirements from sentences
+    if not requirements:
+        sentences = re.split(r'[.!?]+', issue_description)
+        for i, sentence in enumerate(sentences):
+            sentence = sentence.strip()
+            if len(sentence) > 20:  # Skip very short sentences
+                requirements.append({
+                    'id': i + 1,
+                    'text': sentence,
+                    'keywords': [w.lower() for w in sentence.split() if len(w) > 3]
+                })
+    
+    return requirements[:10]  # Limit to first 10 requirements
+
+
+def analyze_changes(proposed_solution: str) -> Dict[str, Any]:
+    """
+    Analyze the proposed solution to identify changed files and their purposes.
+    
+    Args:
+        proposed_solution: The proposed solution text (typically a diff)
+        
+    Returns:
+        Dictionary containing analysis of changes
+    """
+    changes = {
+        'files': [],
+        'total_lines_changed': 0,
+        'additions': 0,
+        'deletions': 0,
+        'modifications': []
+    }
+    
+    # Parse git diff format
+    current_file = None
+    file_pattern = re.compile(r'^diff --git a/(.+) b/(.+)$')
+    index_pattern = re.compile(r'^index [a-f0-9]+\.\.[a-f0-9]+')
+    added_pattern = re.compile(r'^\+[^+]')
+    removed_pattern = re.compile(r'^-[^-]')
+    file_header_pattern = re.compile(r'^--- a/(.+)$')
+    new_file_pattern = re.compile(r'^\+\+\+ b/(.+)$')
+    
+    for line in proposed_solution.split('\n'):
+        file_match = file_pattern.match(line)
+        if file_match:
+            current_file = file_match.group(1)
+            changes['files'].append({
+                'path': current_file,
+                'additions': 0,
+                'deletions': 0,
+                'purpose': ''
+            })
+            continue
+            
+        header_match = file_header_pattern.match(line)
+        if header_match:
+            current_file = header_match.group(1)
+            if not any(f['path'] == current_file for f in changes['files']):
+                changes['files'].append({
+                    'path': current_file,
+                    'additions': 0,
+                    'deletions': 0,
+                    'purpose': ''
+                })
+            continue
+            
+        new_file_match = new_file_pattern.match(line)
+        if new_file_match:
+            current_file = new_file_match.group(1)
+            if not any(f['path'] == current_file for f in changes['files']):
+                changes['files'].append({
+                    'path': current_file,
+                    'additions': 0,
+                    'deletions': 0,
+                    'purpose': ''
+                })
+            continue
+        
+        if added_pattern.match(line):
+            changes['total_lines_changed'] += 1
+            changes['additions'] += 1
+            if current_file and changes['files']:
+                # Find the file and update its addition count
+                for f in changes['files']:
+                    if f['path'] == current_file or current_file.endswith(f['path']):
+                        f['additions'] += 1
+                        break
+        
+        if removed_pattern.match(line):
+            changes['total_lines_changed'] += 1
+            changes['deletions'] += 1
+            if current_file and changes['files']:
+                for f in changes['files']:
+                    if f['path'] == current_file or current_file.endswith(f['path']):
+                        f['deletions'] += 1
+                        break
+    
+    # Determine purpose of each file based on changes
+    for file_info in changes['files']:
+        if file_info['path'].endswith('.py'):
+            if 'test' in file_info['path'].lower():
+                file_info['purpose'] = 'test file'
+            elif 'conftest' in file_info['path'].lower():
+                file_info['purpose'] = 'test configuration'
+            else:
+                file_info['purpose'] = 'implementation file'
+        elif file_info['path'].endswith('.md'):
+            file_info['purpose'] = 'documentation'
+        elif file_info['path'].endswith('.json'):
+            file_info['purpose'] = 'configuration file'
+        elif file_info['path'].endswith('.yml') or file_info['path'].endswith('.yaml'):
+            file_info['purpose'] = 'configuration file'
+        elif file_info['path'].endswith('.txt'):
+            file_info['purpose'] = 'text file'
+        else:
+            file_info['purpose'] = 'unknown'
+    
+    # Determine overall purpose based on all changes
+    if changes['files']:
+        purposes = [f['purpose'] for f in changes['files']]
+        if 'test file' in purposes:
+            changes['overall_purpose'] = 'test updates'
+        elif 'implementation file' in purposes:
+            changes['overall_purpose'] = 'code modifications'
+        elif 'documentation' in purposes:
+            changes['overall_purpose'] = 'documentation updates'
+        else:
+            changes['overall_purpose'] = 'general changes'
+    else:
+        changes['overall_purpose'] = 'no changes detected'
+    
+    return changes
+
+
+def map_changes_to_requirements(requirements: List[Dict], changes: Dict) -> Dict[str, Any]:
+    """
+    Create a mapping showing which requirements each change addresses.
+    
+    Args:
+        requirements: List of extracted requirements
+        changes: Analysis of proposed changes
+        
+    Returns:
+        Dictionary containing the mapping
+    """
+    mapping = {
+        'requirement_links': [],
+        'unlinked_changes': [],
+        'missing_requirements': []
+    }
+    
+    if not requirements or not changes['files']:
+        return mapping
+    
+    # For each requirement, find which files might address it
+    for req in requirements:
+        linked_files = []
+        for file_info in changes['files']:
+            # Check if file path or purpose contains requirement keywords
+            file_keywords = (file_info['path'].lower() + ' ' + file_info['purpose'].lower()).split()
+            req_keywords = req.get('keywords', [])
+            
+            matches = sum(1 for kw in req_keywords if kw in file_keywords)
+            if matches > 0:
+                linked_files.append({
+                    'file': file_info['path'],
+                    'matches': matches,
+                    'requirement_id': req['id'],
+                    'requirement_text': req['text']
+                })
+        
+        if linked_files:
+            mapping['requirement_links'].append({
+                'requirement_id': req['id'],
+                'requirement_text': req['text'],
+                'linked_files': linked_files
+            })
+    
+    # Find unlinked changes (files without requirement links)
+    linked_file_paths = set()
+    for link in mapping['requirement_links']:
+        for file_link in link['linked_files']:
+            linked_file_paths.add(file_link['file'])
+    
+    for file_info in changes['files']:
+        if file_info['path'] not in linked_file_paths:
+            mapping['unlinked_changes'].append({
+                'file': file_info['path'],
+                'purpose': file_info['purpose']
+            })
+    
+    # Find missing requirements (requirements without any linked changes)
+    linked_req_ids = set(link['requirement_id'] for link in mapping['requirement_links'])
+    for req in requirements:
+        if req['id'] not in linked_req_ids:
+            mapping['missing_requirements'].append({
+                'requirement_id': req['id'],
+                'requirement_text': req['text']
+            })
+    
+    return mapping
+
+
+def tool_function(issue_description: str, proposed_solution: str) -> str:
+    """
+    Main tool function that validates requirements coverage.
+    
+    Args:
+        issue_description: The issue description that outlines the requirements
+        proposed_solution: The proposed solution draft or code changes
+        
+    Returns:
+        JSON string containing the validation report
+    """
+    try:
+        # Extract requirements from issue description
+        requirements = extract_requirements(issue_description)
+        
+        # Analyze proposed changes
+        changes = analyze_changes(proposed_solution)
+        
+        # Create mapping of changes to requirements
+        mapping = map_changes_to_requirements(requirements, changes)
+        
+        # Build final report
+        report = {
+            'analysis_summary': {
+                'num_requirements_extracted': len(requirements),
+                'num_files_changed': len(changes['files']),
+                'total_lines_changed': changes['total_lines_changed'],
+                'additions': changes['additions'],
+                'deletions': changes['deletions'],
+                'overall_purpose': changes['overall_purpose']
+            },
+            'requirements': requirements,
+            'changed_files': changes['files'],
+            'requirements_coverage': mapping,
+            'validation_summary': {
+                'requirements_with_coverage': len(mapping['requirement_links']),
+                'unlinked_changes_count': len(mapping['unlinked_changes']),
+                'missing_requirements_count': len(mapping['missing_requirements']),
+                'coverage_percentage': (
+                    len(mapping['requirement_links']) / max(len(requirements), 1) * 100
+                )
+            }
+        }
+        
+        # Add recommendations if there are validation issues
+        recommendations = []
+        if mapping['unlinked_changes']:
+            recommendations.append(
+                f"Found {len(mapping['unlinked_changes'])} file(s) without clear requirement links. "
+                f"Files: {[f['file'] for f in mapping['unlinked_changes']]}"
+            )
+        if mapping['missing_requirements']:
+            recommendations.append(
+                f"Found {len(mapping['missing_requirements'])} requirement(s) not addressed by any changes. "
+                f"Requirements: {[r['requirement_text'] for r in mapping['missing_requirements'][:5]]}"
+            )
+        if not mapping['requirement_links'] and requirements:
+            recommendations.append(
+                "No clear links found between changes and requirements. Please review your changes."
+            )
+        
+        if recommendations:
+            report['recommendations'] = recommendations
+        
+        return json.dumps(report, indent=2)
+    
+    except Exception as e:
+        return json.dumps({
+            'error': str(e),
+            'analysis_summary': {
+                'num_requirements_extracted': 0,
+                'num_files_changed': 0,
+                'success': False
+            }
+        })
+
+
+if __name__ == "__main__":
+    import sys
+    
+    # Example usage
+    if len(sys.argv) < 3:
+        print("Usage: python requirement_validator.py <issue_description> <proposed_solution>")
+        sys.exit(1)
+    
+    issue = sys.argv[1]
+    solution = sys.argv[2]
+    
+    result = tool_function(issue, solution)
+    print(result)
