+# This file implements a tool to trace and analyze how Sphinx processes function signatures.
+
+import ast
+import json
+from inspect import Signature
+from typing import Any
+from sphinx.util.inspect import signature_from_ast, signature_from_str
+
+# Use ast.unparse directly instead of sphinx's unparse to avoid hanging issues
+try:
+    from sphinx.pycode.ast import unparse as sphinx_unparse
+    # Test if sphinx unparse works
+    _test_node = ast.parse("1")
+    _test_result = sphinx_unparse(_test_node.body[0].value)
+    _SPHINX_UNPARSE_AVAILABLE = True
+except (Exception, TimeoutError):
+    _SPHINX_UNPARSE_AVAILABLE = False
+
+
+def tool_info():
+    return {
+        "name": "signature_tracer",
+        "description": """Trace and analyze how Sphinx processes function signatures with complex default arguments.
+This tool helps diagnose rendering bugs by capturing intermediate representations of signature processing.
+It accepts a function signature string and returns a structured report showing:
+1. The parsed AST representation
+2. The string representation at various stages
+3. The final rendered output
+
+Use this tool to systematically test hypotheses about signature rendering bugs before modifying sphinx/pycode/ast.py.
+The tool complements existing tools (test_analysis, run_tests) by providing deeper insight into the specific rendering pipeline.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "function_signature": {
+                    "type": "string",
+                    "description": "The function signature string to analyze (e.g., 'def f(a, b=(1, 2, 3))' or just '(a, b=(1, 2, 3))')."
+                },
+                "test_case_description": {
+                    "type": "string",
+                    "description": "Optional description of the test case or expected behavior."
+                }
+            },
+            "required": ["function_signature"],
+        },
+    }
+
+
+def _unparse_node(node: ast.AST) -> str:
+    """Unparse an AST node using ast.unparse (Python 3.9+) or fallback."""
+    if hasattr(ast, 'unparse'):
+        try:
+            return ast.unparse(node)
+        except Exception:
+            pass
+    
+    # Fallback to simple representation
+    return repr(node)
+
+
+def _parse_signature(signature: str) -> ast.FunctionDef:
+    """Parse a function signature string into an AST node."""
+    # Ensure we have a complete function definition
+    if not signature.startswith('def '):
+        signature = 'def temp' + signature + ': pass'
+    elif not signature.endswith(': pass'):
+        signature = signature + ': pass'
+    
+    try:
+        tree = ast.parse(signature)
+        # Find the function definition
+        for node in ast.walk(tree):
+            if isinstance(node, ast.FunctionDef):
+                return node
+        raise ValueError("Could not find function definition in signature")
+    except SyntaxError as e:
+        raise ValueError(f"Invalid function signature: {signature}. Error: {e}")
+
+
+def _get_ast_dump(node: ast.AST) -> str:
+    """Get a string representation of an AST node."""
+    return ast.dump(node)
+
+
+def _get_ast_source_segment(code: str, node: ast.AST) -> str | None:
+    """Get the source code segment for an AST node."""
+    return ast.get_source_segment(code, node)
+
+
+def _unparse_with_sphinx(node: ast.AST, code: str = '') -> str:
+    """Unparse an AST node using Sphinx's unparser if available."""
+    if _SPHINX_UNPARSE_AVAILABLE:
+        try:
+            return sphinx_unparse(node, code)
+        except (Exception, TimeoutError):
+            pass
+    return _unparse_node(node)
+
+
+def _create_signature_from_ast(node: ast.FunctionDef, code: str = '') -> Signature:
+    """Create an inspect.Signature object from an AST node."""
+    return signature_from_ast(node, code)
+
+
+def _get_parameters_info(sig: Signature) -> dict[str, Any]:
+    """Extract parameter information from a Signature object."""
+    params = {}
+    for name, param in sig.parameters.items():
+        param_info = {
+            'name': name,
+            'kind': str(param.kind),
+        }
+        
+        # Get default value info
+        if param.default != param.empty:
+            param_info['default'] = repr(param.default)
+            if hasattr(param.default, 'value'):
+                # DefaultValue object from Sphinx
+                param_info['default_repr'] = repr(param.default.value)
+        
+        # Get annotation info
+        if param.annotation != param.empty:
+            param_info['annotation'] = str(param.annotation)
+        
+        params[name] = param_info
+    
+    return params
+
+
+def _analyze_defaults(node: ast.FunctionDef) -> dict[str, Any]:
+    """Analyze default values in function arguments."""
+    defaults_info = {
+        'positional_defaults': [],
+        'keyword_only_defaults': [],
+    }
+    
+    # Analyze positional defaults
+    if node.args.defaults:
+        for i, default in enumerate(node.args.defaults):
+            defaults_info['positional_defaults'].append({
+                'index': i,
+                'ast_dump': _get_ast_dump(default),
+                'unparsed': _unparse_node(default),
+            })
+    
+    # Analyze keyword-only defaults
+    if node.args.kw_defaults:
+        for i, default in enumerate(node.args.kw_defaults):
+            if default is not None:
+                defaults_info['keyword_only_defaults'].append({
+                    'index': i,
+                    'ast_dump': _get_ast_dump(default),
+                    'unparsed': _unparse_node(default),
+                })
+    
+    return defaults_info
+
+
+def _create_report(
+    signature: str,
+    test_case_description: str | None,
+    ast_node: ast.FunctionDef,
+    code: str,
+    sig_object: Signature,
+) -> dict[str, Any]:
+    """Create a comprehensive report of signature processing."""
+    report = {
+        'input': {
+            'function_signature': signature,
+            'test_case_description': test_case_description,
+        },
+        'parsing': {
+            'ast_tree': _get_ast_dump(ast_node),
+        },
+        'function_info': {
+            'name': ast_node.name,
+            'args_count': len(ast_node.args.args),
+            'posonlyargs_count': len(ast_node.args.posonlyargs),
+            'kwonlyargs_count': len(ast_node.args.kwonlyargs),
+        },
+        'signature_object': {
+            'str_repr': str(sig_object),
+            'parameters': _get_parameters_info(sig_object),
+        },
+        'defaults_analysis': _analyze_defaults(ast_node),
+        'intermediate_representations': {
+            'args_unparsed': _unparse_node(ast_node.args),
+            'returns_unparsed': _unparse_node(ast_node.returns) if ast_node.returns else None,
+        },
+        'code_segment_extraction': {
+            'function_name': _get_ast_source_segment(code, ast_node),
+        },
+    }
+    
+    # Add argument details
+    args_info = []
+    for i, arg in enumerate(ast_node.args.args):
+        arg_info = {
+            'name': arg.arg,
+            'index': i,
+        }
+        
+        # Get default value if present
+        default_index = i - (len(ast_node.args.args) - len(ast_node.args.defaults))
+        if default_index >= 0:
+            arg_info['default_index'] = default_index
+            arg_info['has_default'] = True
+            default_node = ast_node.args.defaults[default_index]
+            arg_info['default_ast'] = _get_ast_dump(default_node)
+            arg_info['default_str'] = _unparse_node(default_node)
+        else:
+            arg_info['has_default'] = False
+        
+        args_info.append(arg_info)
+    
+    report['arguments'] = args_info
+    
+    return report
+
+
+def tool_function(function_signature: str, test_case_description: str = None) -> str:
+    """
+    Trace and analyze how Sphinx processes a function signature.
+    
+    Args:
+        function_signature: The function signature string to analyze
+        test_case_description: Optional description of the test case
+        
+    Returns:
+        A structured report as a JSON-serializable string showing:
+        - The parsed AST representation
+        - The signature object created by Sphinx
+        - Default value analysis
+        - Intermediate representations at various stages
+    """
+    try:
+        # Parse the signature
+        ast_node = _parse_signature(function_signature)
+        
+        # Get the original code for source segment extraction
+        if not function_signature.startswith('def '):
+            code = 'def temp' + function_signature + ': pass'
+        else:
+            code = function_signature + ': pass'
+        
+        # Create signature object using Sphinx
+        if function_signature.startswith('('):
+            sig_object = signature_from_str(function_signature)
+        else:
+            # Extract signature from def statement
+            sig_str = function_signature[3:].split(':')[0].strip()
+            sig_object = signature_from_str('(' + sig_str + ')')
+        
+        # Create comprehensive report
+        report = _create_report(
+            function_signature,
+            test_case_description,
+            ast_node,
+            code,
+            sig_object,
+        )
+        
+        return json.dumps(report, indent=2, default=str)
+        
+    except Exception as e:
+        error_report = {
+            'error': str(e),
+            'function_signature': function_signature,
+            'test_case_description': test_case_description,
+        }
+        return json.dumps(error_report, indent=2, default=str)
+
+
+if __name__ == "__main__":
+    # Example usage
+    import sys
+    
+    if len(sys.argv) < 2:
+        print("Usage: python signature_tracer.py '<function_signature>' [test_case_description]")
+        print("Example: python signature_tracer.py '(a, b=(1, 2, 3))' 'Testing tuple defaults'")
+    else:
+        signature = sys.argv[1]
+        test_case = sys.argv[2] if len(sys.argv) > 2 else None
+        
+        result = tool_function(signature, test_case)
+        print(result)
