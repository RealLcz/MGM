+def strip_reference_syntax(target: str) -> str:
+    """
+    Strip reference syntax from a target.
+    
+    Handles:
+    - :doc:`target` -> target
+    - `link text <target>`_ -> target
+    - `target`_ -> target
+    """
+    # Remove :doc: wrapper
+    target = re.sub(r'^:doc:`(.*)`$', r'\1', target)
+    
+    # Remove backtick wrapper with link text
+    match = re.match(r'`[^`]+<([^>]+)>`_', target)
+    if match:
+        target = match.group(1)
+    else:
+        # Remove backtick wrapper without link text
+        match = re.match(r'`([^`]+)`_', target)
+        if match:
+            target = match.group(1)
+    
+    # Remove any remaining backticks
+    target = target.replace('`', '').strip()
+    
+    return target
