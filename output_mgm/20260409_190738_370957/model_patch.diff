+# This file implements the proto_test tool for executing Python code snippets.
+
+import ast
+import sys
+import os
+import tempfile
+import subprocess
+from io import StringIO
+from contextlib import redirect_stdout, redirect_stderr
+
+
+def tool_info():
+    return {
+        "name": "proto_test",
+        "description": """Execute small Python code snippets in the repository context to verify hypotheses. This tool is specifically for testing Python code rather than shell commands.
+
+Key features:
+* Accepts Python code as input and executes it in the repository context
+* Supports importing existing modules from the repository
+* Returns output and any exceptions encountered during execution
+* Safe execution environment with output capture
+* Ideal for verifying assumptions before making code changes
+
+Usage examples:
+1. Test a function from the repository:
+   ```python
+   from mymodule import my_function
+   result = my_function(42)
+   print(f"Result: {result}")
+   ```
+
+2. Check if a module can be imported:
+   ```python
+   import mymodule
+   print(mymodule.__version__)
+   ```
+
+3. Test a hypothesis about code behavior:
+   ```python
+   # Test if a certain condition is met
+   result = some_function()
+   assert result is not None, "Function should return a value"
+   print("Test passed: function returns expected value")
+   ```""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "code": {
+                    "type": "string",
+                    "description": "The Python code snippet to execute. Should be a complete, executable code snippet. Can include imports, function calls, and print statements.",
+                },
+                "working_directory": {
+                    "type": "string",
+                    "description": "The working directory to use when executing the code. Defaults to the current directory. Useful for setting the context to the repository root.",
+                },
+            },
+            "required": ["code"],
+        },
+    }
+
+
+def execute_code_in_isolation(code, working_directory=None):
+    """
+    Execute Python code in an isolated environment.
+    
+    Args:
+        code: The Python code string to execute
+        working_directory: Optional working directory to set before execution
+        
+    Returns:
+        A tuple of (stdout, stderr, exception_info)
+    """
+    # Set working directory if specified
+    original_cwd = os.getcwd()
+    if working_directory:
+        try:
+            os.chdir(working_directory)
+        except Exception as e:
+            return "", f"Error changing directory to {working_directory}: {e}", None
+    
+    # Capture stdout and stderr
+    stdout_capture = StringIO()
+    stderr_capture = StringIO()
+    
+    try:
+        # Parse the code to check for syntax errors before execution
+        try:
+            ast.parse(code)
+        except SyntaxError as e:
+            return "", f"SyntaxError: {e}", None
+        
+        # Execute the code in a restricted global namespace
+        # Start with a clean namespace but allow builtins
+        global_vars = {
+            '__name__': '__main__',
+            '__doc__': None,
+            '__package__': None,
+            '__loader__': None,
+            '__spec__': None,
+            '__builtins__': __builtins__,
+        }
+        
+        local_vars = {}
+        
+        with redirect_stdout(stdout_capture), redirect_stderr(stderr_capture):
+            exec(compile(code, '<proto_test>', 'exec'), global_vars, local_vars)
+        
+        stdout_result = stdout_capture.getvalue()
+        stderr_result = stderr_capture.getvalue()
+        exception_info = None
+        
+    except Exception as e:
+        stdout_result = stdout_capture.getvalue()
+        stderr_result = stderr_capture.getvalue()
+        exception_info = str(e)
+    finally:
+        # Always restore the original working directory
+        if working_directory:
+            os.chdir(original_cwd)
+    
+    return stdout_result, stderr_result, exception_info
+
+
+def format_output(stdout, stderr, exception):
+    """
+    Format the output from code execution.
+    
+    Args:
+        stdout: Standard output from execution
+        stderr: Standard error from execution
+        exception: Exception info if any
+        
+    Returns:
+        Formatted string with results
+    """
+    lines = []
+    
+    # Add stdout if present
+    if stdout:
+        lines.append("=== Output ===")
+        lines.append(stdout)
+    
+    # Add stderr if present (excluding normal output from stdout)
+    if stderr:
+        lines.append("=== Errors/Warnings ===")
+        lines.append(stderr)
+    
+    # Add exception info if present
+    if exception:
+        lines.append("=== Exception ===")
+        lines.append(exception)
+    
+    return "\n".join(lines).strip()
+
+
+def tool_function(code, working_directory=None):
+    """
+    Execute a Python code snippet and return the results.
+    
+    Args:
+        code: The Python code to execute
+        working_directory: Optional working directory to use for execution
+        
+    Returns:
+        String containing execution results, output, and any errors
+    """
+    try:
+        stdout, stderr, exception = execute_code_in_isolation(code, working_directory)
+        return format_output(stdout, stderr, exception)
+    except Exception as e:
+        return f"Error executing code: {str(e)}"
+
+
+if __name__ == "__main__":
+    # Example usage
+    import sys
+    
+    # Check if the script is called with arguments
+    if len(sys.argv) < 2:
+        print("Usage: python proto_test.py '<python_code>' [working_directory]")
+        print("\nExample:")
+        print("  python proto_test.py 'print(\"Hello, World!\")'")
+        print("  python proto_test.py 'import sys; print(sys.version)' /path/to/repo")
+    else:
+        # Extract the code from command-line arguments
+        input_code = sys.argv[1]
+        
+        # Get optional working directory
+        working_dir = sys.argv[2] if len(sys.argv) > 2 else None
+        
+        # Run the tool_function
+        result = tool_function(input_code, working_dir)
+        print(result)
