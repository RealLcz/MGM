+#!/usr/bin/env python3
+"""
+Demo script to show how the proto_test tool works.
+"""
+
+from tools.proto_test import tool_function
+
+print("=" * 80)
+print("Proto_test Tool Demo")
+print("=" * 80)
+print()
+
+# Example 1: Simple print statement
+print("Example 1: Simple print statement")
+print("-" * 40)
+code1 = 'print("Hello from proto_test!")'
+result1 = tool_function(code1)
+print(f"Code: {repr(code1)}")
+print(f"Result:\n{result1}")
+print()
+
+# Example 2: Function definition and call
+print("Example 2: Function definition and call")
+print("-" * 40)
+code2 = '''
+def factorial(n):
+    if n <= 1:
+        return 1
+    return n * factorial(n - 1)
+
+print(f"Factorial of 5: {factorial(5)}")
+
+# Call factorial directly
+print(f"Factorial of 3: {factorial(3)}")
+'''
+result2 = tool_function(code2)
+print(f"Code: {repr(code2)}")
+print(f"Result:\n{result2}")
+print()
+
+# Example 3: Import and use built-in module
+print("Example 3: Import and use built-in module")
+print("-" * 40)
+code3 = '''
+import os
+print(f"Current directory: {os.getcwd()}")
+print(f"Python version: {os.sys.version}")
+'''
+result3 = tool_function(code3)
+print(f"Code: {repr(code3)}")
+print(f"Result:\n{result3}")
+print()
+
+# Example 4: Exception handling
+print("Example 4: Exception handling (division by zero)")
+print("-" * 40)
+code4 = '''
+def divide(a, b):
+    try:
+        return a / b
+    except ZeroDivisionError:
+        return "Cannot divide by zero"
+
+print(divide(10, 2))
+print(divide(10, 0))
+'''
+result4 = tool_function(code4)
+print(f"Code: {repr(code4)}")
+print(f"Result:\n{result4}")
+print()
+
+# Example 5: Working with data structures
+print("Example 5: Working with data structures")
+print("-" * 40)
+code5 = '''
+# Create a list of squares
+squares = [x**2 for x in range(10)]
+print(f"Squares: {squares}")
+
+# Create a dictionary
+person = {"name": "Alice", "age": 30}
+print(f"Person: {person}")
+'''
+result5 = tool_function(code5)
+print(f"Code: {repr(code5)}")
+print(f"Result:\n{result5}")
+print()
+
+# Example 6: Syntax error handling
+print("Example 6: Syntax error handling")
+print("-" * 40)
+code6 = 'print("unclosed quote'
+result6 = tool_function(code6)
+print(f"Code: {repr(code6)}")
+print(f"Result:\n{result6}")
+print()
+
+# Example 7: Using assert statements
+print("Example 7: Using assert statements to verify hypotheses")
+print("-" * 40)
+code7 = '''
+def is_positive(n):
+    return n > 0
+
+# Test the function
+assert is_positive(5), "5 should be positive"
+assert not is_positive(-3), "-3 should not be positive"
+print("All assertions passed!")
+'''
+result7 = tool_function(code7)
+print(f"Code: {repr(code7)}")
+print(f"Result:\n{result7}")
+print()
+
+print("=" * 80)
+print("Demo complete!")
+print("=" * 80)
