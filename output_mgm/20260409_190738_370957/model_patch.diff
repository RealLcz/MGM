+# Tests for the proto_test tool.
+
+import pytest
+
+from tools.proto_test import tool_function
+
+
+class TestProtoTestTool:
+    def test_simple_print_statement(self):
+        """Test running a simple print statement."""
+        result = tool_function("print('hello world')")
+        assert "hello world" in result
+        assert "Error" not in result
+
+    def test_arithmetic_operations(self):
+        """Test arithmetic operations."""
+        result = tool_function("print(2 + 2)")
+        assert "4" in result
+
+    def test_variable_assignment_and_use(self):
+        """Test variable assignment and use."""
+        result = tool_function("x = 42\nprint(x)")
+        assert "42" in result
+
+    def test_function_definition_and_call(self):
+        """Test function definition and call."""
+        result = tool_function("def add(a, b):\n    return a + b\nprint(add(2, 3))")
+        assert "5" in result
+
+    def test_import_and_use_builtin_module(self):
+        """Test importing and using a built-in module."""
+        result = tool_function("import os\nprint(os.getcwd())")
+        assert "Error" not in result
+        assert "cwd" in result.lower() or "output" in result.lower()
+
+    def test_syntax_error_handling(self):
+        """Test handling of syntax errors."""
+        result = tool_function("print('unclosed quote")
+        assert "Error" in result or "SyntaxError" in result
+
+    def test_exception_handling(self):
+        """Test handling of exceptions."""
+        result = tool_function("x = 1/0")
+        assert "Exception" in result or "ZeroDivisionError" in result
+
+    def test_multiple_statements(self):
+        """Test multiple statements."""
+        result = tool_function("a = 1\nb = 2\nc = a + b\nprint(c)")
+        assert "3" in result
+
+    def test_list_operations(self):
+        """Test list operations."""
+        result = tool_function("my_list = [1, 2, 3]\nprint(len(my_list))")
+        assert "3" in result
+
+    def test_dict_operations(self):
+        """Test dictionary operations."""
+        result = tool_function("my_dict = {'key': 'value'}\nprint(my_dict['key'])")
+        assert "value" in result
+
+    def test_working_directory_parameter(self):
+        """Test working directory parameter."""
+        result = tool_function("import os\nprint(os.getcwd())", working_directory="/tmp")
+        assert "tmp" in result or "Error" in result  # May error or succeed depending on system
+
+    def test_import_existing_module(self):
+        """Test importing an existing module."""
+        result = tool_function("import sys\nprint(sys.version_info.major)")
+        assert "3" in result
+
+    def test_conditional_statement(self):
+        """Test conditional statements."""
+        result = tool_function("x = 10\nif x > 5:\n    print('greater')\nelse:\n    print('smaller')")
+        assert "greater" in result
+
+    def test_for_loop(self):
+        """Test for loops."""
+        result = tool_function("result = []\nfor i in range(3):\n    result.append(i)\nprint(result)")
+        assert "0" in result and "1" in result and "2" in result
+
+    def test_class_definition(self):
+        """Test class definition and instantiation."""
+        result = tool_function("class Test:\n    def __init__(self):\n        self.value = 42\nobj = Test()\nprint(obj.value)")
+        assert "42" in result
+
