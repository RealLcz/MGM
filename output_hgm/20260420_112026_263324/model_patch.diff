+def tool_info():
+    """Return tool information."""
+    return {
+        "name": "trace_cli",
+        "description": """Execute CLI commands with real-time tracing capabilities. This tool extends bash execution by:
+
+1. Capturing variable states at key decision points (especially conditional checks)
+2. Providing structured output showing execution path, input values, and decision outcomes
+3. Analyzing validation failures to identify root causes
+4. Tracing execution flow for debugging input handling logic
+
+Use this tool when you need to understand:
+- Why validation logic fails for edge cases (e.g., empty strings in path validation)
+- How inputs propagate through validation functions
+- Where conditional logic evaluates to unexpected values
+- The complete execution path of CLI applications
+""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {"type": "string", "description": "The CLI command to execute with tracing."},
+                "stdin": {"type": "string", "description": "Simulated stdin input for the command (optional)."},
+                "mode": {"type": "string", "enum": ["execute", "analyze"], "description": "Mode of operation: 'execute' for basic tracing, 'analyze' for detailed validation failure analysis."}
+            },
+            "required": ["command"],
+        },
+    }
+
+
+def tool_function(command: str, stdin: str = None, mode: str = "execute") -> str:
+    """
+    Execute a CLI command with tracing capabilities.
+    
+    Args:
+        command: CLI command to execute
+        stdin: Simulated stdin input (optional)
+        mode: Operation mode - 'execute' for tracing, 'analyze' for validation analysis
+        
+    Returns:
+        Structured string output with execution trace and analysis
+    """
+    try:
+        if mode == "analyze":
+            # Use the specialized validation analysis
+            result = analyze_validation_failure(command, stdin or "")
+        else:
+            # Standard execution with tracing
+            result = simulate_cli_command(command, stdin)
+        
+        # Format the output
+        output_lines = []
+        output_lines.append("=" * 80)
+        output_lines.append("TRACED CLI EXECUTION")
+        output_lines.append("=" * 80)
+        output_lines.append(f"\nCommand: {result.get('command', 'N/A')}")
+        output_lines.append(f"Stdin: {result.get('stdin', 'None') or 'None'}")
+        output_lines.append(f"Exit Code: {result.get('exit_code', 'N/A')}")
+        
+        # Add execution summary
+        summary = result.get('execution_summary', {})
+        if summary:
+            output_lines.append(f"\n--- Execution Summary ---")
+            output_lines.append(f"Total Events: {summary.get('total_events', 0)}")
+            output_lines.append(f"Decision Points: {summary.get('total_decisions', 0)}")
+            if 'execution_type' in summary:
+                output_lines.append(f"Execution Type: {summary['execution_type']}")
+            if 'error' in summary:
+                output_lines.append(f"Error: {summary['error']}")
+        
+        # Add stdout
+        stdout = result.get('stdout', '')
+        if stdout:
+            output_lines.append(f"\n--- Standard Output ---")
+            output_lines.append(stdout)
+        
+        # Add stderr
+        stderr = result.get('stderr', '')
+        if stderr:
+            output_lines.append(f"\n--- Standard Error ---")
+            output_lines.append(stderr)
+        
+        # Add decision points if available
+        decision_points = result.get('decision_points', [])
+        if decision_points:
+            output_lines.append(f"\n--- Decision Points ({len(decision_points)}) ---")
+            for i, dp in enumerate(decision_points, 1):
+                output_lines.append(f"\nDecision {i}:")
+                output_lines.append(f"  Line: {dp.get('line_no', 'N/A')}")
+                output_lines.append(f"  Function: {dp.get('function', 'N/A')}")
+                output_lines.append(f"  Condition: {dp.get('condition', 'N/A')}")
+                output_lines.append(f"  Result: {dp.get('condition_result', 'N/A')}")
+                if dp.get('variables'):
+                    output_lines.append(f"  Variables: {dp['variables']}")
+        
+        # Add validation recommendations if available
+        if 'validation_decisions' in result:
+            recommendations = result.get('recommendations', [])
+            if recommendations:
+                output_lines.append(f"\n--- Validation Analysis ---")
+                for rec in recommendations:
+                    output_lines.append(f"  - {rec}")
+        
+        # Add trace events if available (limited for readability)
+        trace_events = result.get('trace_events', [])
+        if trace_events:
+            output_lines.append(f"\n--- Execution Trace ({len(trace_events)} events) ---")
+            # Show first 10 events
+            for event in trace_events[:10]:
+                output_lines.append(f"  [{event.get('event_type', 'unknown')}] "
+                                  f"{event.get('function_name', 'N/A')}:"
+                                  f"l.{event.get('line_no', 'N/A')} - "
+                                  f"vars: {list(event.get('variables', {}).keys())}")
+            if len(trace_events) > 10:
+                output_lines.append(f"  ... and {len(trace_events) - 10} more events")
+        
+        output_lines.append("\n" + "=" * 80)
+        
+        return "\n".join(output_lines)
+        
+    except Exception as e:
+        return f"Error in trace_cli tool: {str(e)}\n{traceback.format_exc()}"
+
