+# Framework test utilities for agentic coding
+
+"""
+This module provides utilities for framework-aware testing that can be used
+by the coding agent to understand and work with different testing frameworks.
+"""
+
+import re
+from pathlib import Path
+from typing import Dict, List, Optional, Tuple, Any
+
+# Framework detection patterns
+FRAMEWORK_PATTERNS = {
+    "django": {
+        "files": ["manage.py", "settings.py", "wsgi.py", "urls.py"],
+        "test_files": ["tests.py", "test.py", "test_*.py", "*_test.py"],
+        "test_classes": ["TestCase", "TransactionTestCase", "SimpleTestCase", "LiveServerTestCase"],
+        "test_methods": ["test_"],
+        "runner": "python manage.py test",
+        "test_patterns": {
+            "class": r'class\s+(\w+)\((.*?)TestCase\)',
+            "method": r'def\s+(test_\w+)\(\s*self',
+        },
+        "generate_test_instructions": """
+For Django tests:
+- Use django.test.TestCase for database tests
+- Use django.test.SimpleTestCase for non-database tests
+- Use django.test.TransactionTestCase for tests involving transaction management
+- Include tests for:
+  * Model validation and saving
+  * View permissions and access control
+  * Form validation and submission
+  * API endpoint behavior
+  * Error handling
+- Test edge cases and error conditions
+- Use fixtures for test data when appropriate
+- Test both success and failure paths
+""",
+    },
+    "pytest": {
+        "files": ["pytest.ini", "pyproject.toml", "setup.cfg"],
+        "test_files": ["test_*.py", "*_test.py", "tests/"],
+        "test_classes": ["Test"],
+        "test_methods": ["test_"],
+        "runner": "pytest",
+        "test_patterns": {
+            "class": r'class\s+(\w+)\((.*?)Test',
+            "method": r'def\s+(test_\w+)\(\s*[^,)]',
+        },
+        "generate_test_instructions": """
+For pytest tests:
+- Use pytest for simple, functional testing
+- Use pytest fixtures for test setup/teardown
+- Use parametrize for parameterized tests
+- Include tests for:
+  * Function behavior and edge cases
+  * Input validation
+  * Error handling
+  * Performance considerations
+- Keep tests small and focused
+- Use meaningful test names that describe the scenario
+""",
+    },
+    "unittest": {
+        "files": [],
+        "test_files": ["test_*.py", "*_test.py"],
+        "test_classes": ["TestCase"],
+        "test_methods": ["test_"],
+        "runner": "python -m unittest",
+        "test_patterns": {
+            "class": r'class\s+(\w+)\((.*?)TestCase\)',
+            "method": r'def\s+(test_\w+)\(\s*self',
+        },
+        "generate_test_instructions": """
+For unittest tests:
+- Extend unittest.TestCase for test classes
+- Use setUp and tearDown for test setup
+- Include tests for:
+  * Basic functionality
+  * Edge cases
+  * Error handling
+- Use assert methods (assertEqual, assertTrue, etc.)
+- Organize tests by functionality
+""",
+    },
+}
+
