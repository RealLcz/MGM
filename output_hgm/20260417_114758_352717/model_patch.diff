+def extract_test_cases(file_path: str, framework: str = None) -> List[Dict[str, Any]]:
+    """
+    Extract test cases from a test file.
+    
+    Args:
+        file_path: Path to the test file
+        framework: Optional framework name
+        
+    Returns:
+        List of test case information
+    """
+    test_cases = []
+    
+    try:
+        content = Path(file_path).read_text()
+    except Exception:
+        return test_cases
+    
+    # Parse based on framework
+    if framework == "django" or framework is None:
+        # Django/Python test patterns
+        # Class-based tests
+        class_pattern = r'class\s+(\w+)\(.*?(TestCase|Test)\):\s*\n(.*?)(?=\nclass|\Z)'
+        matches = re.findall(class_pattern, content, re.DOTALL)
+        
+        for class_name, _, class_body in matches:
+            # Find test methods
+            method_pattern = r'def\s+(test_\w+)\(self\)'
+            methods = re.findall(method_pattern, class_body)
+            
+            for method in methods:
+                test_cases.append({
+                    "file": file_path,
+                    "class": class_name,
+                    "method": method,
+                    "type": "method",
+                })
+        
+        # Standalone test functions
+        standalone_pattern = r'def\s+(test_\w+)\(.*?\):\s*\n'
+        standalone_methods = re.findall(standalone_pattern, content)
+        
+        for method in standalone_methods:
+            # Check if already captured in class
+            if not any(tc["method"] == method and tc.get("class") is None for tc in test_cases):
+                test_cases.append({
+                    "file": file_path,
+                    "method": method,
+                    "type": "function",
+                })
+    
+    elif framework == "pytest":
+        # Pytest patterns (similar to unittest but more flexible)
+        class_pattern = r'class\s+(\w+)\(.*?(Test|.TestCase)\):\s*\n(.*?)(?=\nclass|\Z)'
+        matches = re.findall(class_pattern, content, re.DOTALL)
+        
+        for class_name, _, class_body in matches:
+            method_pattern = r'def\s+(test_\w+)\(self'
+            methods = re.findall(method_pattern, class_body)
+            
+            for method in methods:
+                test_cases.append({
+                    "file": file_path,
+                    "class": class_name,
+                    "method": method,
+                    "type": "method",
+                })
+        
+        # Standalone test functions
+        standalone_pattern = r'def\s+(test_\w+)\(.*?\):\s*\n'
+        standalone_methods = re.findall(standalone_pattern, content)
+        
+        for method in standalone_methods:
+            if not any(tc["method"] == method and tc.get("class") is None for tc in test_cases):
+                test_cases.append({
+                    "file": file_path,
+                    "method": method,
+                    "type": "function",
+                })
+    
+    return test_cases
+
+
+def get_framework_instructions(framework: str) -> str:
+    """
+    Get framework-specific test generation instructions.
+    
+    Args:
+        framework: The framework name
+        
+    Returns:
+        Framework-specific test instructions
+    """
+    if framework == "none" or framework not in FRAMEWORK_PATTERNS:
+        framework = "unittest"
+    
+    return FRAMEWORK_PATTERNS[framework]["generate_test_instructions"]
+
+
+def generate_test_prompt(issue_description: str, framework: str) -> str:
+    """
+    Generate a comprehensive prompt for test generation based on issue and framework.
+    
+    Args:
+        issue_description: The problem description
+        framework: The framework being used
+        
+    Returns:
