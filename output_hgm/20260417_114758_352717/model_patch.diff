+def detect_framework(repo_path: str) -> Tuple[str, Dict[str, Any]]:
+    """
+    Detect the testing framework being used in a repository.
+    
+    Args:
+        repo_path: Path to the repository directory
+        
+    Returns:
+        Tuple of (framework_name, detection_info)
+    """
+    repo_path = Path(repo_path)
+    detected_frameworks = {}
+    
+    for framework, patterns in FRAMEWORK_PATTERNS.items():
+        score = 0
+        found_files = []
+        
+        # Check for framework-specific files
+        for pattern in patterns.get("files", []):
+            matches = list(repo_path.rglob(pattern))
+            if matches:
+                score += 2
+                found_files.extend([str(m) for m in matches])
+        
+        # Check for test files
+        for pattern in patterns.get("test_files", []):
+            matches = list(repo_path.rglob(pattern))
+            if matches:
+                score += 1
+                found_files.extend([str(m) for m in matches])
+        
+        # Check for test classes in Python files
+        if patterns.get("test_classes"):
+            for python_file in repo_path.rglob("*.py"):
+                try:
+                    content = python_file.read_text()
+                    for test_class in patterns["test_classes"]:
+                        if re.search(rf'class\s+\w+\({test_class}\)', content):
+                            score += 1
+                except Exception:
+                    pass
+        
+        if score > 0:
+            detected_frameworks[framework] = {
+                "score": score,
+                "found_files": found_files[:10],  # Limit to first 10 files
+            }
+    
+    if not detected_frameworks:
+        return "none", {"detected": False, "reason": "No framework patterns detected"}
+    
+    # Return the framework with highest score
+    best_framework = max(detected_frameworks.items(), key=lambda x: x[1]["score"])
+    return best_framework[0], best_framework[1]
+
+
+def find_test_files(repo_path: str, framework: str = None) -> List[str]:
+    """
+    Find all test files in the repository.
+    
+    Args:
+        repo_path: Path to the repository
+        framework: Optional framework name to filter by
+        
+    Returns:
+        List of test file paths
+    """
+    repo_path = Path(repo_path)
+    test_files = []
+    
+    if framework:
+        patterns = FRAMEWORK_PATTERNS.get(framework, {}).get("test_files", [])
+    else:
+        patterns = []
+        for fw_patterns in FRAMEWORK_PATTERNS.values():
+            patterns.extend(fw_patterns.get("test_files", []))
+    
+    for pattern in patterns:
+        # Handle directory patterns
+        if pattern.endswith("/"):
+            pattern = pattern[:-1] + "**/test*.py"
+        
+        matches = list(repo_path.rglob(pattern))
+        test_files.extend([str(m) for m in matches])
+    
+    # Remove duplicates
+    return list(set(test_files))
+
