+    if framework == "django" and repo_path:
+        # For Django, ensure we're in the right directory
+        repo_path = Path(repo_path)
+        manage_py = repo_path / "manage.py"
+        if manage_py.exists():
+            project_dir = manage_py.parent
+            return f"cd {project_dir} && {runner}"
