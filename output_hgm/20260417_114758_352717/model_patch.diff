+                    results["error"].append(test_name)
+                    results["error_count"] += 1
+            
+            results["success"] = results["failed_count"] == 0 and results["error_count"] == 0
+        except Exception:
+            # Fallback to generic parsing
+            pass
+    
+    elif framework == "pytest":
+        # Parse pytest output
+        import re
+        
+        # Try to extract test results from pytest output
+        passed_matches = re.findall(r'(\d+) passed', output)
+        failed_matches = re.findall(r'(\d+) failed', output)
+        skipped_matches = re.findall(r'(\d+) skipped', output)
+        
+        results["passed_count"] = int(passed_matches[0]) if passed_matches else 0
+        results["failed_count"] = int(failed_matches[0]) if failed_matches else 0
+        results["skipped_count"] = int(skipped_matches[0]) if skipped_matches else 0
+        results["total"] = results["passed_count"] + results["failed_count"] + results["skipped_count"]
+        
+        # Extract individual failed tests
+        failed_test_pattern = r'FAILED\s+(\S+)'
+        results["failed"] = re.findall(failed_test_pattern, output)
+        
+        # Extract individual error tests
+        error_test_pattern = r'ERROR\s+(\S+)'
+        results["error"] = re.findall(error_test_pattern, output)
+        
+        # Extract individual passed tests (if available)
+        passed_test_pattern = r'PASSED\s+(\S+)'
+        results["passed"] = re.findall(passed_test_pattern, output)
+        
+        results["success"] = results["failed_count"] == 0 and results["error_count"] == 0
+    
+    elif framework == "unittest":
+        # Parse unittest output
+        import re
+        
+        passed_matches = re.findall(r'OK\(\$(\d+)\$', output)
+        failed_matches = re.findall(r'FAILED\(\$(\d+)\$', output)
+        
+        results["passed_count"] = int(passed_matches[0]) if passed_matches else 0
+        results["failed_count"] = int(failed_matches[0]) if failed_matches else 0
+        results["total"] = results["passed_count"] + results["failed_count"]
+        
+        # Extract individual test results
+        failed_pattern = r'FAIL:\s+(\S+)'
+        results["failed"] = re.findall(failed_pattern, output)
+        
+        error_pattern = r'ERROR:\s+(\S+)'
+        results["error"] = re.findall(error_pattern, output)
+        
+        results["success"] = results["failed_count"] == 0 and results["error_count"] == 0
+    
+    else:
+        # Generic parsing
+        lines = output.split('\n')
+        for line in lines:
+            line = line.strip()
+            if 'PASSED' in line or 'ok' in line:
+                results["passed_count"] += 1
+                results["total"] += 1
+            elif 'FAILED' in line or 'FAIL' in line:
+                results["failed_count"] += 1
+                results["total"] += 1
+            elif 'SKIPPED' in line or 'SKIP' in line:
+                results["skipped_count"] += 1
+                results["total"] += 1
+            elif 'ERROR' in line:
+                results["error_count"] += 1
+                results["total"] += 1
+        
+        results["success"] = results["failed_count"] == 0 and results["error_count"] == 0
+    
+    return results
