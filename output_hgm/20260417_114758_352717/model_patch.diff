+# Framework-aware testing utilities for agentic coding
+
+"""
+This module provides utilities for framework-specific testing:
+1. Detecting the framework being used
+2. Generating appropriate test cases
+3. Running framework-specific test suites
+4. Interpreting test failures
+"""
+
+import os
+import re
+from pathlib import Path
+from typing import Dict, List, Optional, Tuple, Any
+
+# Framework detection patterns
+FRAMEWORK_PATTERNS = {
+    "django": {
+        "files": ["manage.py", "settings.py", "wsgi.py", "urls.py"],
+        "test_files": ["tests.py", "test.py", "test_*.py", "*_test.py"],
+        "test_classes": ["TestCase", "TransactionTestCase", "SimpleTestCase", "LiveServerTestCase"],
+        "test_methods": ["test_"],
+        "runner": "python manage.py test",
+    },
+    "pytest": {
+        "files": ["pytest.ini", "pyproject.toml", "setup.cfg"],
+        "test_files": ["test_*.py", "*_test.py", "tests/"],
+        "test_classes": ["Test"],
+        "test_methods": ["test_"],
+        "runner": "pytest",
+    },
+    "unittest": {
+        "files": [],
+        "test_files": ["test_*.py", "*_test.py"],
+        "test_classes": ["TestCase"],
+        "test_methods": ["test_"],
+        "runner": "python -m unittest",
+    },
+}
+
+
+def detect_framework(repo_path: str) -> Tuple[str, Dict[str, Any]]:
+    """
+    Detect the testing framework being used in a repository.
+    
+    Args:
+        repo_path: Path to the repository directory
+        
+    Returns:
+        Tuple of (framework_name, detection_info)
+    """
+    repo_path = Path(repo_path)
+    detected_frameworks = {}
+    
+    for framework, patterns in FRAMEWORK_PATTERNS.items():
+        score = 0
+        found_files = []
+        
+        # Check for framework-specific files
+        for pattern in patterns.get("files", []):
+            matches = list(repo_path.rglob(pattern))
+            if matches:
+                score += 2
+                found_files.extend([str(m) for m in matches])
+        
+        # Check for test files
+        for pattern in patterns.get("test_files", []):
+            matches = list(repo_path.rglob(pattern))
+            if matches:
+                score += 1
+                found_files.extend([str(m) for m in matches])
+        
+        # Check for test classes in Python files
+        if patterns.get("test_classes"):
+            for python_file in repo_path.rglob("*.py"):
+                try:
+                    content = python_file.read_text()
+                    for test_class in patterns["test_classes"]:
+                        if re.search(rf'class\s+\w+\({test_class}\)', content):
+                            score += 1
+                except Exception:
+                    pass
+        
+        if score > 0:
+            detected_frameworks[framework] = {
+                "score": score,
+                "found_files": found_files[:10],  # Limit to first 10 files
+            }
+    
+    if not detected_frameworks:
+        return "none", {"detected": False, "reason": "No framework patterns detected"}
+    
+    # Return the framework with highest score
+    best_framework = max(detected_frameworks.items(), key=lambda x: x[1]["score"])
+    return best_framework[0], best_framework[1]
+
+
+def find_test_files(repo_path: str, framework: str = None) -> List[str]:
+    """
+    Find all test files in the repository.
+    
+    Args:
+        repo_path: Path to the repository
+        framework: Optional framework name to filter by
+        
+    Returns:
+        List of test file paths
+    """
+    repo_path = Path(repo_path)
+    test_files = []
+    
+    if framework:
+        patterns = FRAMEWORK_PATTERNS.get(framework, {}).get("test_files", [])
+    else:
+        patterns = []
+        for fw_patterns in FRAMEWORK_PATTERNS.values():
+            patterns.extend(fw_patterns.get("test_files", []))
+    
+    for pattern in patterns:
+        # Handle directory patterns
+        if pattern.endswith("/"):
+            pattern = pattern[:-1] + "**/test*.py"
+        
+        matches = list(repo_path.rglob(pattern))
+        test_files.extend([str(m) for m in matches])
+    
+    # Remove duplicates
+    return list(set(test_files))
+
+
+def extract_test_cases(file_path: str, framework: str = None) -> List[Dict[str, Any]]:
+    """
+    Extract test cases from a test file.
+    
+    Args:
+        file_path: Path to the test file
+        framework: Optional framework name
+        
+    Returns:
+        List of test case information
+    """
+    test_cases = []
+    
+    try:
+        content = Path(file_path).read_text()
+    except Exception:
+        return test_cases
+    
+    # Parse based on framework
+    if framework == "django" or framework is None:
+        # Django/Python test patterns
+        # Class-based tests
+        class_pattern = r'class\s+(\w+)\(.*?(TestCase|Test)\):\s*\n(.*?)(?=\nclass|\Z)'
+        matches = re.findall(class_pattern, content, re.DOTALL)
+        
+        for class_name, _, class_body in matches:
+            # Find test methods
+            method_pattern = r'def\s+(test_\w+)\(self\)'
+            methods = re.findall(method_pattern, class_body)
+            
+            for method in methods:
+                test_cases.append({
+                    "file": file_path,
+                    "class": class_name,
+                    "method": method,
+                    "type": "method",
+                })
+        
+        # Standalone test functions
+        standalone_pattern = r'def\s+(test_\w+)\(.*?\):\s*\n'
+        standalone_methods = re.findall(standalone_pattern, content)
+        
+        for method in standalone_methods:
+            # Check if already captured in class
+            if not any(tc["method"] == method and tc.get("class") is None for tc in test_cases):
+                test_cases.append({
+                    "file": file_path,
+                    "method": method,
+                    "type": "function",
+                })
+    
+    elif framework == "pytest":
+        # Pytest patterns (similar to unittest but more flexible)
+        class_pattern = r'class\s+(\w+)\(.*?(Test|.TestCase)\):\s*\n(.*?)(?=\nclass|\Z)'
+        matches = re.findall(class_pattern, content, re.DOTALL)
+        
+        for class_name, _, class_body in matches:
+            method_pattern = r'def\s+(test_\w+)\(self'
+            methods = re.findall(method_pattern, class_body)
+            
+            for method in methods:
+                test_cases.append({
+                    "file": file_path,
+                    "class": class_name,
+                    "method": method,
+                    "type": "method",
+                })
+        
+        # Standalone test functions
+        standalone_pattern = r'def\s+(test_\w+)\(.*?\):\s*\n'
+        standalone_methods = re.findall(standalone_pattern, content)
+        
+        for method in standalone_methods:
+            if not any(tc["method"] == method and tc.get("class") is None for tc in test_cases):
+                test_cases.append({
+                    "file": file_path,
+                    "method": method,
+                    "type": "function",
+                })
+    
+    return test_cases
+
+
+def generate_test_description(issue_description: str, framework: str) -> str:
+    """
+    Generate appropriate test description based on issue and framework.
+    
+    Args:
+        issue_description: The problem description
+        framework: The framework being used
+        
+    Returns:
+        Formatted test description
+    """
+    framework_guidelines = {
+        "django": """
+For Django tests:
+- Use django.test.TestCase for database tests
+- Use django.test.SimpleTestCase for non-database tests
+- Use django.test.TransactionTestCase for tests involving transaction management
+- Include tests for:
+  * Model validation and saving
+  * View permissions and access control
+  * Form validation and submission
+  * API endpoint behavior
+  * Error handling
+- Test edge cases and error conditions
+- Use fixtures for test data when appropriate
+- Test both success and failure paths
+""",
+        "pytest": """
+For pytest tests:
+- Use pytest for simple, functional testing
+- Use pytest fixtures for test setup/teardown
+- Use parametrize for parameterized tests
+- Include tests for:
+  * Function behavior and edge cases
+  * Input validation
+  * Error handling
+  * Performance considerations
+- Keep tests small and focused
+- Use meaningful test names that describe the scenario
+""",
+        "unittest": """
+For unittest tests:
+- Extend unittest.TestCase for test classes
+- Use setUp and tearDown for test setup
+- Include tests for:
+  * Basic functionality
+  * Edge cases
+  * Error handling
+- Use assert methods (assertEqual, assertTrue, etc.)
+- Organize tests by functionality
+""",
+    }
+    
+    framework_info = framework_guidelines.get(framework, framework_guidelines["unittest"])
+    
+    return f"""Based on the issue description:
+
+{issue_description}
+
+Please write tests that follow the {framework.upper()} testing conventions:
+
+{framework_info}
+
+Generate test cases that would verify the fix for this issue.
+The tests should be comprehensive and cover all relevant scenarios.
+"""
+
+
+def run_framework_tests(repo_path: str, framework: str, test_args: str = "") -> Tuple[str, int]:
+    """
+    Run tests using the appropriate framework command.
+    
+    Args:
+        repo_path: Path to the repository
+        framework: Framework name
+        test_args: Additional arguments to pass to the test runner
+        
+    Returns:
+        Tuple of (output, return_code)
+    """
+    repo_path = Path(repo_path)
+    
+    if framework == "none":
+        return "No framework detected. Cannot run framework-specific tests.", 1
+    
+    config = FRAMEWORK_PATTERNS.get(framework, {})
+    runner = config.get("runner", "")
+    
+    if not runner:
+        return f"No test runner configured for {framework}.", 1
+    
+    # For Django, change to the directory with manage.py
+    if framework == "django":
+        manage_py = repo_path / "manage.py"
+        if manage_py.exists():
+            # Find the project directory
+            project_dir = manage_py.parent
+            command = f"cd {project_dir} && {runner} {test_args}".strip()
+        else:
+            # Try to find any manage.py
+            manage_py_files = list(repo_path.rglob("manage.py"))
+            if manage_py_files:
+                project_dir = manage_py_files[0].parent
+                command = f"cd {project_dir} && {runner} {test_args}".strip()
+            else:
+                return "No manage.py found. Cannot run Django tests.", 1
+    else:
+        command = f"cd {repo_path} && {runner} {test_args}".strip()
+    
+    import subprocess
+    
+    try:
+        result = subprocess.run(
+            command,
+            shell=True,
+            capture_output=True,
+            text=True,
+            timeout=300,  # 5 minute timeout
+        )
+        output = result.stdout + result.stderr
+        return_code = result.returncode
+    except subprocess.TimeoutExpired:
+        return "Test execution timed out after 5 minutes.", 124
+    except Exception as e:
+        return f"Error running tests: {str(e)}", 1
+    
+    return output, return_code
+
+
+def parse_test_results(output: str, framework: str) -> Dict[str, Any]:
+    """
+    Parse test results from framework output.
+    
+    Args:
+        output: Test output from framework
+        framework: Framework name
+        
+    Returns:
+        Dictionary with parsed test results
+    """
+    results = {
+        "passed": [],
+        "failed": [],
+        "skipped": [],
+        "error": [],
+        "total": 0,
+        "passed_count": 0,
+        "failed_count": 0,
+        "skipped_count": 0,
+        "error_count": 0,
+    }
+    
+    if framework == "django":
+        from utils.swe_log_parsers import parse_log_django
+        parsed = parse_log_django(output)
+        
+        for test_name, status in parsed.items():
+            results["total"] += 1
+            if status == "PASSED":
+                results["passed"].append(test_name)
+                results["passed_count"] += 1
+            elif status == "FAILED":
+                results["failed"].append(test_name)
+                results["failed_count"] += 1
+            elif status == "SKIPPED":
+                results["skipped"].append(test_name)
+                results["skipped_count"] += 1
+            elif status == "ERROR":
+                results["error"].append(test_name)
+                results["error_count"] += 1
+    
+    elif framework == "pytest":
+        # Parse pytest output
+        import re
+        
+        # Try to extract test results from pytest output
+        passed_matches = re.findall(r'(\d+) passed', output)
+        failed_matches = re.findall(r'(\d+) failed', output)
+        skipped_matches = re.findall(r'(\d+) skipped', output)
+        
+        results["passed_count"] = int(passed_matches[0]) if passed_matches else 0
+        results["failed_count"] = int(failed_matches[0]) if failed_matches else 0
+        results["skipped_count"] = int(skipped_matches[0]) if skipped_matches else 0
+        results["total"] = results["passed_count"] + results["failed_count"] + results["skipped_count"]
+        
+        # Extract individual failed tests
+        failed_test_pattern = r'FAILED\s+(\S+)'
+        results["failed"] = re.findall(failed_test_pattern, output)
+        
+        # Extract individual error tests
+        error_test_pattern = r'ERROR\s+(\S+)'
+        results["error"] = re.findall(error_test_pattern, output)
+        
+        # Extract individual passed tests (if available)
+        passed_test_pattern = r'PASSED\s+(\S+)'
+        results["passed"] = re.findall(passed_test_pattern, output)
+    
+    elif framework == "unittest":
+        # Parse unittest output
+        import re
+        
+        passed_matches = re.findall(r'OK\(\$(\d+)\$', output)
+        failed_matches = re.findall(r'FAILED\(\$(\d+)\$', output)
+        
+        results["passed_count"] = int(passed_matches[0]) if passed_matches else 0
+        results["failed_count"] = int(failed_matches[0]) if failed_matches else 0
+        results["total"] = results["passed_count"] + results["failed_count"]
+        
+        # Extract individual test results
+        failed_pattern = r'FAIL:\s+(\S+)'
+        results["failed"] = re.findall(failed_pattern, output)
+        
+        error_pattern = r'ERROR:\s+(\S+)'
+        results["error"] = re.findall(error_pattern, output)
+    
+    else:
+        # Generic parsing
+        lines = output.split('\n')
+        for line in lines:
+            line = line.strip()
+            if 'PASSED' in line or 'ok' in line:
+                results["passed_count"] += 1
+                results["total"] += 1
+            elif 'FAILED' in line or 'FAIL' in line:
+                results["failed_count"] += 1
+                results["total"] += 1
+            elif 'SKIPPED' in line or 'SKIP' in line:
+                results["skipped_count"] += 1
+                results["total"] += 1
+            elif 'ERROR' in line:
+                results["error_count"] += 1
+                results["total"] += 1
+    
+    return results
+
+
+def get_framework_test_commands(framework: str, test_args: str = "") -> Dict[str, str]:
+    """
+    Get appropriate test commands for a framework.
+    
+    Args:
+        framework: Framework name
+        test_args: Additional arguments
+        
+    Returns:
+        Dictionary with various test commands
+    """
+    commands = {
+        "all": "",
+        "specific_test": "",
+        "verbose": "",
+        "parallel": "",
+    }
+    
+    if framework == "django":
+        base = "python manage.py test"
+        commands["all"] = f"{base} {test_args}"
+        commands["specific_test"] = f"{base} app_name.TestClass.test_method {test_args}"
+        commands["verbose"] = f"{base} --verbosity=2 {test_args}"
+        commands["parallel"] = f"{base} --parallel {test_args}"
+    elif framework == "pytest":
+        base = "pytest"
+        commands["all"] = f"{base} {test_args}"
+        commands["specific_test"] = f"{base} path/to/test_file.py::TestClass::test_method {test_args}"
+        commands["verbose"] = f"{base} -v {test_args}"
+        commands["parallel"] = f"{base} -n auto {test_args}"
+    elif framework == "unittest":
+        base = "python -m unittest"
+        commands["all"] = f"{base} discover {test_args}"
+        commands["specific_test"] = f"{base} path.to.test_module.TestClass.test_method {test_args}"
+        commands["verbose"] = f"{base} -v {test_args}"
+        commands["parallel"] = f"{base} (not supported natively, use pytest)"
+    
+    return commands
