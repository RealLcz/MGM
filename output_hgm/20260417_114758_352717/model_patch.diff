+async def tool_function_call_with_test_support(command):
+    """Execute a command in the bash shell with support for framework tests."""
+    try:
+        bash_session = BashSession()
+
+        if not bash_session._started:
+            await bash_session.start()
+
+        # Check if this is a framework-specific test command
+        if command.startswith("test:"):
+            result = await handle_framework_test_command(command[5:].strip())
+            return result
+        
+        output, error = await bash_session.run(command)
+        error = filter_error(error)
+        result = ""
+        if output:
+            result += output
+        if error:
+            result += "\nError:\n" + error
+        return result.strip()
+    except Exception as e:
+        return f"Error: {str(e)}"
+
+
+async def handle_framework_test_command(subcommand: str) -> str:
+    """
+    Handle framework-specific test commands.
+    
+    Args:
+        subcommand: The test command after the 'test:' prefix
+        
+    Returns:
+        String result of the test operation
+    """
+    # Get the repository path (use current working directory)
+    repo_path = os.getcwd()
+    
+    # Detect framework
+    framework, _ = detect_framework(repo_path)
+    
+    # Special help command
+    if subcommand == "help":
+        commands = get_framework_test_commands(framework)
+        help_text = f"""Framework Test Commands
+====================
+
+Detected Framework: {framework}
+
+Available Commands:
+- test:help          - Show this help message
+- test:run           - Run all tests
+- test:run [args]    - Run tests with additional arguments
+- test:commands      - Show available test commands for this framework
+
+Detected framework: {framework}
+Framework-specific test runner: {FRAMEWORK_PATTERNS.get(framework, {}).get("runner", "N/A")}
+
+Use 'test:run' to execute the test suite for this framework.
+"""
+        return help_text
+    
+    # Show available commands
+    if subcommand == "commands":
+        commands = get_framework_test_commands(framework)
+        command_list = "\n".join([f"- {k}: {v}" for k, v in commands.items()])
+        return f"Available test commands for {framework}:\n\n{command_list}"
+    
+    # Run all tests
+    if subcommand == "run" or subcommand == "":
+        test_args = subcommand.replace("run", "").strip()
+        output, return_code = run_framework_tests(repo_path, framework, test_args)
+        return output
+    
+    # Run with specific args
+    if subcommand:
+        output, return_code = run_framework_tests(repo_path, framework, subcommand)
+        return output
+    
