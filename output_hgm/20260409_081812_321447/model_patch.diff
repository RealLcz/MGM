+# This file provides utilities for running tests
+
+import subprocess
+import sys
+from pathlib import Path
+
+
+def run_pytest(test_paths=None, pytest_args=None):
+    """
+    Run pytest on specified test paths or directories.
+    
+    Args:
+        test_paths: List of test file/directory paths to run
+        pytest_args: List of additional pytest arguments
+        
+    Returns:
+        str: Test output and result
+    """
+    try:
+        cmd = [sys.executable, "-m", "pytest", "-v"]
+        
+        if test_paths:
+            cmd.extend(test_paths)
+        
+        if pytest_args:
+            cmd.extend(pytest_args)
+        
+        result = subprocess.run(
+            cmd,
+            capture_output=True,
+            text=True,
+            timeout=300  # 5 minute timeout
+        )
+        
+        output = result.stdout + result.stderr
+        
+        if result.returncode == 0:
+            return f"Tests passed successfully!\n\n{output}"
+        else:
+            return f"Tests failed.\n\n{output}"
+            
+    except subprocess.TimeoutExpired:
+        return "Error: Tests timed out after 5 minutes."
+    except Exception as e:
+        return f"Error running tests: {str(e)}"
+
+
+def run_test_file(test_path):
+    """
+    Run tests in a specific test file.
+    
+    Args:
+        test_path: Path to the test file
+        
+    Returns:
+        str: Test output and result
+    """
+    return run_pytest([str(test_path)])
+
+
+def discover_tests(directory=None):
+    """
+    Discover test files in a directory.
+    
+    Args:
+        directory: Directory to search for tests (default: current directory)
+        
+    Returns:
+        list: List of test file paths
+    """
+    try:
+        if directory is None:
+            directory = "."
+        
+        directory = Path(directory)
+        
+        # Find all test files
+        test_files = []
+        for pattern in ["test_*.py", "*_test.py"]:
+            test_files.extend(directory.rglob(pattern))
+        
+        return [str(f) for f in test_files if f.is_file()]
+        
+    except Exception as e:
+        return f"Error discovering tests: {str(e)}"
+
+
+if __name__ == "__main__":
+    # Example usage
+    result = run_test_file("tests/test_edit_tool.py")
+    print(result)
