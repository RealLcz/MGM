+def edit_test(path: str, file_text: str, context_lines: int = 0) -> str:
+    """
+    Edit a file and automatically run tests to verify the changes.
+    
+    This is a convenience function that combines edit with test running.
+    
+    Args:
+        path: Path to the file to edit
+        file_text: New content for the file
+        context_lines: Number of context lines to validate before editing (optional)
+        
+    Returns:
+        str: Result of the edit operation and test results
+    """
+    try:
+        path_obj = validate_path(path, "edit")
+        
+        # If context_lines is specified, validate first
+        if context_lines > 0:
+            current_content = read_file(path_obj)
+            if file_text not in current_content:
+                return f"Validation failed: Target content not found in file before editing."
+        
+        # Perform the edit
+        write_file(path_obj, file_text)
+        
+        # Run tests
+        test_result = run_tests_for_file(path_obj)
+        
+        return f"File at {path} has been edited.\n\nTest Results:\n{test_result}"
+        
+    except Exception as e:
+        return f"Error: {str(e)}"
+
+
+def run_tests_for_file(file_path: Path) -> str:
+    """
+    Run tests for a given file.
+    
+    Args:
+        file_path: Path to the file being tested
+        
+    Returns:
+        str: Test results
+    """
+    try:
+        # Import test_runner here to avoid circular imports
+        from tools.test_runner import run_test_file, discover_tests
+        
+        # Try to find corresponding test file
+        test_file = None
+        file_name = file_path.stem
+        
+        # Common test file patterns
+        test_patterns = [
+            file_path.parent / f"test_{file_name}.py",
+            file_path.parent / f"{file_name}_test.py",
+        ]
+        
+        # Look for test file in common locations
+        for test_path in test_patterns:
+            if test_path.exists():
+                test_file = test_path
+                break
+        
+        # If no specific test file, look for any test file in the directory
+        if test_file is None:
+            test_files = list(file_path.parent.glob("test_*.py"))
+            if test_files:
+                test_file = test_files[0]
+        
+        # Run tests
+        if test_file:
+            return run_test_file(test_file)
+        else:
+            # Try running tests in the parent directory
+            return run_test_file(file_path.parent)
+            
+    except Exception as e:
+        return f"Error running tests: {str(e)}"
+
