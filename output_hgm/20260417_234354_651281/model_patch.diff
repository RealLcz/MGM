+def tool_function(repository_path: str, model_name: Optional[str] = None, 
+                  action: str = "analyze") -> str:
+    """
+    Main tool function for Django model inheritance analysis.
+    
+    Args:
+        repository_path: Path to the Django repository
+        model_name: Optional model name to analyze
+        action: Action to perform ('analyze', 'fix', 'generate_tests')
+        
+    Returns:
+        String result of the operation
+    """
+    # Validate inputs
+    repo_path = Path(repository_path)
+    if not repo_path.exists():
+        return f"Error: Repository path does not exist: {repository_path}"
+    
+    # Perform the requested action
+    if action == "analyze":
+        result = analyze_models(repository_path, model_name)
+        return json.dumps(result, indent=2, default=str)
+    
+    elif action == "fix":
+        # First analyze to find conflicts
+        analysis = analyze_models(repository_path, model_name)
+        conflicts = analysis.get("conflicts", [])
+        
+        if not conflicts:
+            return json.dumps({
+                "status": "no_changes_needed",
+                "message": "No parent_link conflicts detected",
+                "models_analyzed": analysis.get("summary", {}).get("total_models", 0),
+            }, indent=2)
+        
+        # Apply fixes
+        fix_results = apply_fixes(repository_path, conflicts)
+        return json.dumps({
+            "status": "fixes_applied",
+            "summary": fix_results,
+            "conflicts_found": len(conflicts),
+        }, indent=2)
+    
+    elif action == "generate_tests":
+        # Generate test file
+        test_result = generate_test_file(repository_path, model_name)
+        return json.dumps({
+            "status": "tests_generated",
+            "models_analyzed": test_result["models_analyzed"],
+            "test_content": test_result["test_content"],
+        }, indent=2)
+    
+    else:
+        return f"Error: Unknown action '{action}'. Valid actions: analyze, fix, generate_tests"
+
+
