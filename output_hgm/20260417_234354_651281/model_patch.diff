+        fields = conflict.get("one_to_one_fields", [])
+        
+        if not file_path:
+            results["skipped"].append({
+                "model": model_name,
+                "reason": "No file path available",
+            })
+            continue
+        
+        try:
+            content = Path(file_path).read_text()
+            lines = content.split('\n')
+            
+            # Find and fix the first OneToOneField
+            fixed = False
+            for i, line in enumerate(lines):
+                if 'OneToOneField' in line and not line.strip().startswith('#'):
+                    if i >= conflict.get("line", 1) - 1:
+                        # Check if parent_link is already present
+                        if 'parent_link' in line:
+                            results["skipped"].append({
+                                "model": model_name,
+                                "reason": "parent_link already present",
+                            })
+                            fixed = True
+                            break
+                        
+                        # Add parent_link=True to the first OneToOneField
+                        if 'OneToOneField(' in line:
+                            # Find the closing parenthesis and add parent_link before it
+                            idx = line.rfind('OneToOneField(') + len('OneToOneField(')
+                            if line.rstrip().endswith(')'):
+                                # Insert parent_link=True before the closing paren
+                                line_parts = line.rsplit(')', 1)
+                                if len(line_parts) == 2:
+                                    lines[i] = f"{line_parts[0]}, parent_link=True)"
+                                    fixed = True
+                                    break
+                            else:
+                                # Multi-line field definition
+                                # This is more complex and would need better parsing
+                                pass
+            
+            if fixed:
+                new_content = '\n'.join(lines)
+                Path(file_path).write_text(new_content)
+                results["applied"].append({
+                    "model": model_name,
+                    "file": file_path,
+                })
+            else:
+                results["skipped"].append({
+                    "model": model_name,
+                    "reason": "Could not determine fix location",
+                })
+                
+        except Exception as e:
+            results["errors"].append({
+                "model": model_name,
+                "error": str(e),
+            })
+    
+    return results
+
