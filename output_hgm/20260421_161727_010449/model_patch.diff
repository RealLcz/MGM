+# This file implements a Root Cause Analysis tool for debugging.
+
+import re
+from typing import Dict, List, Optional, Any
+
+
+def tool_info():
+    """Return metadata about the debug analysis tool."""
+    return {
+        "name": "debug_analysis",
+        "description": """Perform root cause analysis on bugs by analyzing error messages, code context, and generating targeted test cases.
+This tool helps systematically identify and verify the root cause of bugs by:
+1. Parsing error messages and stack traces
+2. Analyzing validation logic in code (like is_path function)
+3. Identifying edge cases in user input handling
+4. Generating targeted test cases to verify fixes
+
+Use this tool early in the problem-solving process to generate a structured analysis report that informs subsequent patch generation.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "bug_description": {
+                    "type": "string",
+                    "description": "Detailed description of the bug, including error messages and unexpected behavior."
+                },
+                "code_context": {
+                    "type": "string",
+                    "description": "Relevant code context, including the relevant functions, classes, and file paths involved in the bug."
+                },
+                "file_path": {
+                    "type": "string",
+                    "description": "Path to the file containing the buggy code (optional but recommended)."
+                }
+            },
+            "required": ["bug_description", "code_context"]
+        }
+    }
+
+
+def parse_error_messages(bug_description: str) -> Dict[str, Any]:
+    """
+    Parse error messages and stack traces from bug description.
+    
+    Args:
+        bug_description: The bug description containing error messages
+        
+    Returns:
+        Dictionary with parsed error information
+    """
+    error_info = {
+        "error_type": None,
+        "error_message": None,
+        "stack_trace": [],
+        "potential_causes": []
+    }
+    
+    # Common error patterns
+    error_patterns = [
+        (r"(?P<type>\w+Error): (?P<message>.+)", "Python error"),
+        (r"Error: (?P<message>.+)", "Generic error"),
+        (r"Traceback \(most recent call last\):", "Stack trace"),
+    ]
+    
+    lines = bug_description.split("\n")
+    in_stack_trace = False
+    stack_trace_lines = []
+    
+    for line in lines:
+        line = line.strip()
+        
+        # Check for stack trace start
+        if "Traceback (most recent call last):" in line:
+            in_stack_trace = True
+            continue
+            
+        # Check for error lines
+        for pattern, error_type in error_patterns:
+            match = re.match(pattern, line)
+            if match:
+                if error_type == "Python error":
+                    error_info["error_type"] = match.group("type")
+                    error_info["error_message"] = match.group("message")
+                elif error_type == "Generic error":
+                    error_info["error_message"] = match.group("message")
+                continue
+        
+        # Collect stack trace lines
+        if in_stack_trace:
+            if line and not line.startswith("File ") and not line.startswith("  "):
+                # New error or end of stack trace
+                in_stack_trace = False
+                if stack_trace_lines:
+                    error_info["stack_trace"] = stack_trace_lines
+                    stack_trace_lines = []
+                continue
+            
+            if line.startswith("File "):
+                stack_trace_lines.append(line)
+    
+    # Capture remaining stack trace
+    if stack_trace_lines:
+        error_info["stack_trace"] = stack_trace_lines
+    
+    return error_info
+
+
+def analyze_validation_logic(code_context: str, bug_description: str) -> Dict[str, Any]:
+    """
+    Analyze validation logic in the code context.
+    
+    Args:
+        code_context: The code to analyze
+        bug_description: Description of the bug
+        
+    Returns:
+        Dictionary with validation analysis results
+    """
+    analysis = {
+        "validation_functions": [],
+        "potential_issues": [],
+        "path_handling": False,
+        "input_validation": False
+    }
+    
+    # Look for validation-related patterns
+    validation_patterns = [
+        (r"def (is_\w+)\(", "Validation function"),
+        (r"def (check_\w+)\(", "Check function"),
+        (r"if.*assert", "Assertion"),
+        (r"raise.*ValueError", "Value validation"),
+        (r"raise.*TypeError", "Type validation"),
+        (r"raise.*FileNotFoundError", "File path validation"),
+        (r"path.*exists", "Path existence check"),
+        (r"os\.path", "OS path handling"),
+    ]
+    
+    # Also look for function definitions to capture function names
+    function_pattern = r"def\s+(\w+)\s*\("
+    
+    lines = code_context.split("\n")
+    for i, line in enumerate(lines, 1):
+        # First, check for validation patterns
+        for pattern, pattern_type in validation_patterns:
+            if re.search(pattern, line):
+                analysis["validation_functions"].append({
+                    "line": i,
+                    "type": pattern_type,
+                    "content": line.strip()
+                })
+        
+        # Then, check for function definitions
+        func_match = re.search(function_pattern, line)
+        if func_match:
+            func_name = func_match.group(1)
+            # Only add if it's not already in the list (avoid duplicates)
+            if line.strip() not in [f.get('content', '') for f in analysis['validation_functions']]:
+                analysis["validation_functions"].append({
+                    "line": i,
+                    "type": "Validation function",
+                    "content": line.strip(),
+                    "function_name": func_name
+                })
+    
+    # Check if path handling is involved
+    if "path" in bug_description.lower() or "path" in code_context.lower():
+        analysis["path_handling"] = True
+        
+        # Look for path validation issues
+        if "is_path" in code_context or "validate_path" in code_context:
+            analysis["potential_issues"].append({
+                "issue": "Path validation logic may have edge case issues",
+                "severity": "medium",
+                "description": "The path validation logic might not handle all edge cases properly, such as relative paths, symlinks, or special characters."
+            })
+    
+    # Check for input validation issues
+    if "input" in bug_description.lower() or "user" in bug_description.lower():
+        analysis["input_validation"] = True
+        if analysis["validation_functions"]:
+            analysis["potential_issues"].append({
+                "issue": "Input validation may be incomplete",
+                "severity": "high",
+                "description": "Input validation functions might not cover all edge cases or malicious inputs."
+            })
+    
+    return analysis
+
+
+def identify_edge_cases(code_context: str, bug_description: str) -> List[Dict[str, Any]]:
+    """
+    Identify potential edge cases in the code.
+    
+    Args:
+        code_context: The code to analyze
+        bug_description: Description of the bug
+        
+    Returns:
+        List of identified edge cases
+    """
+    edge_cases = []
+    
+    # Common edge case patterns
+    edge_case_patterns = [
+        (r"^[^#]*def.*\(.*\):", "Function definitions"),
+        (r"for .* in .*:", "Iteration patterns"),
+        (r"if.*else", "Conditional logic"),
+        (r"try.*except", "Exception handling"),
+        (r"\[.*\]", "List indexing"),
+        (r"\{.*:.*\}", "Dictionary access"),
+        (r"/", "Division or path operations"),
+        (r"str\(|int\(|float\(", "Type conversion"),
+    ]
+    
+    # Look for potential edge cases based on the bug description
+    if "empty" in bug_description.lower():
+        edge_cases.append({
+            "case": "Empty input",
+            "line": None,
+            "description": "Consider handling empty strings, lists, or dictionaries",
+            "code_pattern": "if not input:"
+        })
+    
+    if "none" in bug_description.lower() or "null" in bug_description.lower():
+        edge_cases.append({
+            "case": "None/null input",
+            "line": None,
+            "description": "Consider handling None or null values",
+            "code_pattern": "if input is None:"
+        })
+    
+    if "path" in bug_description.lower():
+        edge_cases.extend([
+            {
+                "case": "Non-existent path",
+                "line": None,
+                "description": "Path might not exist",
+                "code_pattern": "if not os.path.exists(path):"
+            },
+            {
+                "case": "Relative path",
+                "line": None,
+                "description": "Path might be relative instead of absolute",
+                "code_pattern": "if not os.path.isabs(path):"
+            },
+            {
+                "case": "Symlink",
+                "line": None,
+                "description": "Path might be a symlink",
+                "code_pattern": "if os.path.islink(path):"
+            },
+            {
+                "case": "Special characters in path",
+                "line": None,
+                "description": "Path might contain special characters that need escaping",
+                "code_pattern": "Check for special characters in path string"
+            }
+        ])
+    
+    # Look for specific patterns in the code
+    lines = code_context.split("\n")
+    for i, line in enumerate(lines, 1):
+        # Check for potential off-by-one errors
+        if "for i in range" in line and "len(" in "".join(lines[i:i+5]):
+            edge_cases.append({
+                "case": "Off-by-one error",
+                "line": i,
+                "description": "Loop might have off-by-one error",
+                "code_pattern": "Check loop bounds carefully"
+            })
+        
+        # Check for division by zero
+        if "/" in line and "0" in line:
+            edge_cases.append({
+                "case": "Division by zero",
+                "line": i,
+                "description": "Potential division by zero",
+                "code_pattern": "if divisor != 0:"
+            })
+        
+        # Check for list indexing
+        if "[" in line and "]" in line:
+            # Check if it's a list access pattern
+            if re.search(r"\w+\[\d+\]", line):
+                edge_cases.append({
+                    "case": "Fixed index access",
+                    "line": i,
+                    "description": "Fixed index access might cause IndexError",
+                    "code_pattern": "Use len() to check bounds"
+                })
+    
+    return edge_cases
+
+
+def generate_test_cases(bug_description: str, analysis_results: Dict[str, Any]) -> List[Dict[str, Any]]:
+    """
+    Generate targeted test cases based on the analysis.
+    
+    Args:
+        bug_description: Description of the bug
+        analysis_results: Results from previous analysis steps
+        
+    Returns:
+        List of test cases
+    """
+    test_cases = []
+    
+    # Base test case structure
+    base_test = {
+        "test_name": "",
+        "description": "",
+        "input": {},
+        "expected_output": None,
+        "test_type": ""
+    }
+    
+    # Generate tests based on identified edge cases
+    edge_cases = analysis_results.get("edge_cases", [])
+    for edge_case in edge_cases:
+        test_name = f"test_{edge_case['case'].replace(' ', '_').lower()}"
+        test_case = {
+            "test_name": test_name,
+            "description": f"Test {edge_case['description'].lower()}",
+            "input": {"test_input": edge_case["case"]},
+            "expected_output": "Should handle gracefully without error",
+            "test_type": "edge_case",
+            "code_suggestion": edge_case.get("code_pattern", "")
+        }
+        test_cases.append(test_case)
+    
+    # Generate tests based on validation issues
+    validation_analysis = analysis_results.get("validation", {})
+    if validation_analysis.get("potential_issues"):
+        for issue in validation_analysis["potential_issues"]:
+            test_case = {
+                "test_name": f"test_{issue['issue'].replace(' ', '_').lower()}",
+                "description": issue["description"],
+                "input": {"test_case": "validation_edge_case"},
+                "expected_output": "Should raise appropriate error or handle gracefully",
+                "test_type": "validation",
+                "severity": issue.get("severity", "medium")
+            }
+            test_cases.append(test_case)
+    
+    # Generate specific tests based on bug description
+    if "path" in bug_description.lower():
+        test_cases.extend([
+            {
+                "test_name": "test_path_validation",
+                "description": "Test path validation with various inputs",
+                "input": {
+                    "test_cases": [
+                        "normal_path",
+                        "nonexistent_path", 
+                        "relative_path",
+                        "path_with_spaces",
+                        "path_with_special_chars"
+                    ]
+                },
+                "expected_output": "Should validate paths correctly",
+                "test_type": "path_validation"
+            },
+            {
+                "test_name": "test_absolute_path_requirement",
+                "description": "Test that only absolute paths are accepted",
+                "input": {
+                    "test_cases": [
+                        "/absolute/path",
+                        "./relative/path",
+                        "../parent/path"
+                    ]
+                },
+                "expected_output": "Only absolute paths should pass validation",
+                "test_type": "absolute_path_check"
+            }
+        ])
+    
+    if "error" in bug_description.lower() or "exception" in bug_description.lower():
+        test_cases.extend([
+            {
+                "test_name": "test_error_handling",
+                "description": "Test error handling with invalid inputs",
+                "input": {
+                    "invalid_inputs": [
+                        "None",
+                        "Empty string",
+                        "Wrong type",
+                        "Out of range value"
+                    ]
+                },
+                "expected_output": "Should handle errors gracefully",
+                "test_type": "error_handling"
+            }
+        ])
+    
+    return test_cases
+
+
+def tool_function(bug_description: str, code_context: str, file_path: str = None) -> str:
+    """
+    Perform root cause analysis on the given bug description and code context.
+    
+    Args:
+        bug_description: Detailed description of the bug
+        code_context: Relevant code context
+        file_path: Optional path to the file containing the buggy code
+        
+    Returns:
+        A structured analysis report
+    """
+    # Parse error messages
+    error_info = parse_error_messages(bug_description)
+    
+    # Analyze validation logic
+    validation_analysis = analyze_validation_logic(code_context, bug_description)
+    
+    # Identify edge cases
+    edge_cases = identify_edge_cases(code_context, bug_description)
+    
+    # Combine analysis results
+    analysis_results = {
+        "file_path": file_path,
+        "bug_description": bug_description,
+        "error_analysis": error_info,
+        "validation_analysis": validation_analysis,
+        "edge_cases": edge_cases
+    }
+    
+    # Generate test cases
+    test_cases = generate_test_cases(bug_description, analysis_results)
+    
+    # Build the analysis report
+    report = []
+    report.append("=" * 80)
+    report.append("ROOT CAUSE ANALYSIS REPORT")
+    report.append("=" * 80)
+    report.append("")
+    
+    # Error Analysis Section
+    report.append("1. ERROR MESSAGE ANALYSIS")
+    report.append("-" * 40)
+    if error_info["error_type"]:
+        report.append(f"Error Type: {error_info['error_type']}")
+    if error_info["error_message"]:
+        report.append(f"Error Message: {error_info['error_message']}")
+    if error_info["stack_trace"]:
+        report.append("Stack Trace:")
+        for trace_line in error_info["stack_trace"]:
+            report.append(f"  {trace_line}")
+    report.append("")
+    
+    # Validation Analysis Section
+    report.append("2. VALIDATION LOGIC ANALYSIS")
+    report.append("-" * 40)
+    if validation_analysis["validation_functions"]:
+        report.append("Validation Functions Found:")
+        for func in validation_analysis["validation_functions"]:
+            report.append(f"  Line {func['line']}: {func['type']}")
+            report.append(f"    {func['content']}")
+    
+    if validation_analysis["potential_issues"]:
+        report.append("\nPotential Issues:")
+        for issue in validation_analysis["potential_issues"]:
+            report.append(f"  [{issue['severity'].upper()}] {issue['issue']}")
+            report.append(f"    {issue['description']}")
+    
+    report.append("")
+    
+    # Edge Cases Section
+    report.append("3. IDENTIFIED EDGE CASES")
+    report.append("-" * 40)
+    if edge_cases:
+        for i, edge_case in enumerate(edge_cases, 1):
+            report.append(f"{i}. {edge_case['case']}")
+            report.append(f"   Description: {edge_case['description']}")
+            if edge_case.get("line"):
+                report.append(f"   Line: {edge_case['line']}")
+            if edge_case.get("code_pattern"):
+                report.append(f"   Suggested Check: {edge_case['code_pattern']}")
+    else:
+        report.append("No specific edge cases identified. Consider adding defensive checks.")
+    report.append("")
+    
+    # Test Cases Section
+    report.append("4. TARGETED TEST CASES")
+    report.append("-" * 40)
+    if test_cases:
+        for i, test_case in enumerate(test_cases, 1):
+            report.append(f"\nTest Case {i}: {test_case['test_name']}")
+            report.append(f"  Description: {test_case['description']}")
+            report.append(f"  Type: {test_case['test_type']}")
+            if test_case.get("input"):
+                report.append(f"  Input: {test_case['input']}")
+            if test_case.get("expected_output"):
+                report.append(f"  Expected: {test_case['expected_output']}")
+            if test_case.get("code_suggestion"):
+                report.append(f"  Code Suggestion: {test_case['code_suggestion']}")
+    else:
+        report.append("No test cases generated.")
+    report.append("")
+    
+    # Summary Section
+    report.append("5. SUMMARY AND RECOMMENDATIONS")
+    report.append("-" * 40)
+    
+    # Count issues
+    total_issues = (
+        len(validation_analysis.get("potential_issues", [])) +
+        len(edge_cases)
+    )
+    
+    report.append(f"Total issues identified: {total_issues}")
+    
+    if validation_analysis.get("path_handling"):
+        report.append("- Path handling logic should be reviewed carefully")
+        report.append("- Consider adding explicit checks for:")
+        report.append("  * Path existence (os.path.exists)")
+        report.append("  * Absolute path requirement (os.path.isabs)")
+        report.append("  * Path validity (os.path.isdir, os.path.isfile)")
+    
+    if validation_analysis.get("input_validation"):
+        report.append("- Input validation logic should be reviewed")
+        report.append("- Consider adding:")
+        report.append("  * Type checking")
+        report.append("  * Value range validation")
+        report.append("  * Empty/null handling")
+    
+    report.append("")
+    report.append("=" * 80)
+    report.append("END OF REPORT")
+    report.append("=" * 80)
+    
+    return "\n".join(report)
+
