+def _setup_django(settings_module: Optional[str] = None) -> None:
+    """
+    Setup Django environment if not already configured.
+    
+    Args:
+        settings_module: Optional Django settings module path.
+    """
+    import django
+    from django.conf import settings
+    
+    # Only setup if Django hasn't been configured yet
+    if not settings.configured:
+        # Try to find Django settings
+        if settings_module is None:
+            # Common settings module locations
+            possible_settings = [
+                "settings",
+                "myproject.settings",
+                "project.settings",
+                "app.settings",
+            ]
+            
+            for settings_path in possible_settings:
+                try:
+                    spec = importlib.util.find_spec(settings_path)
+                    if spec:
+                        settings_module = settings_path
+                        break
+                except ImportError:
+                    continue
+        
+        if settings_module:
+            settings.configure(
+                DEBUG=True,
+                DATABASES={
+                    'default': {
+                        'ENGINE': 'django.db.backends.sqlite3',
+                        'NAME': ':memory:',
+                    }
+                },
+                INSTALLED_APPS=[
+                    'django.contrib.contenttypes',
+                    'django.contrib.auth',
+                ],
+                USE_TZ=True,
+            )
+            django.setup()
+
+
+def _load_models_from_path(model_path: str) -> List[Any]:
+    """
+    Load Django models from a Python file path.
+    
+    Args:
+        model_path: Path to a Python file containing Django models.
+        
+    Returns:
+        List of model classes found in the file.
+    """
+    _setup_django()
+    
+    models = []
+    try:
+        # Import the module
+        spec = importlib.util.spec_from_file_location("dynamic_models", model_path)
+        if spec and spec.loader:
+            module = importlib.util.module_from_spec(spec)
+            sys.modules["dynamic_models"] = module
+            spec.loader.exec_module(module)
+            
+            # Find all model classes in the module
+            import django.db.models as django_models
+            for name in dir(module):
+                obj = getattr(module, name)
+                if (hasattr(obj, '_meta') and 
+                    isinstance(obj._meta, django_models.options.Options) and
+                    not obj._meta.abstract):
+                    models.append(obj)
+    except Exception as e:
+        raise ValueError(f"Failed to load models from {model_path}: {e}")
+    
+    return models
+
+
+def _load_model_by_name(model_class_name: str) -> Any:
+    """
+    Load a Django model class by name.
+    
+    Args:
+        model_class_name: Full path to the model class (e.g., 'app.models.MyModel').
+        
+    Returns:
+        The model class object.
+    """
+    _setup_django()
+    
+    try:
+        # Try to import the model
+        if '.' in model_class_name:
+            module_path, class_name = model_class_name.rsplit('.', 1)
+            module = importlib.import_module(module_path)
+            model = getattr(module, class_name)
+            
+            # Verify it's a Django model
+            if hasattr(model, '_meta'):
+                return model
+            else:
+                raise ValueError(f"{model_class_name} is not a Django model class")
+        else:
+            raise ValueError(f"Model class name must include module path: {model_class_name}")
+    except Exception as e:
+        raise ValueError(f"Failed to load model {model_class_name}: {e}")
+
