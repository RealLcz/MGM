+def _analyze_inheritance_hierarchy(model_class: Any) -> Dict[str, Any]:
+    """
+    Analyze the inheritance hierarchy of a Django model.
+    
+    Args:
+        model_class: Django model class to analyze.
+        
+    Returns:
+        Dictionary containing inheritance hierarchy information.
+    """
+    from django.db.models import options
+    
+    hierarchy = []
+    current = model_class
+    visited = set()
+    
+    while current and hasattr(current, '_meta'):
+        if current in visited:
+            break
+        visited.add(current)
+        
+        meta = current._meta
+        model_info = {
+            "model_name": current.__name__,
+            "app_label": meta.app_label,
+            "db_table": meta.db_table,
+            "abstract": meta.abstract,
+            "fields": [],
+            "parent_fields": [],
+            "related_fields": [],
+        }
+        
+        # Analyze fields
+        for field in meta.get_fields():
+            field_info = {
+                "name": field.name,
+                "type": type(field).__name__,
+                "auto_created": field.auto_created,
+                "related_model": None,
+            }
+            
+            if hasattr(field, 'related_model') and field.related_model:
+                field_info["related_model"] = field.related_model.__name__
+            
+            if field.auto_created:
+                model_info["related_fields"].append(field_info)
+            else:
+                model_info["fields"].append(field_info)
+            
+            # Check if it's a parent link
+            if hasattr(field, 'parent_link') and field.parent_link:
+                field_info["parent_link"] = True
+                model_info["parent_link_field"] = field.name
+            
+            # Check if it's a one-to-one field
+            if type(field).__name__ == 'OneToOneField':
+                field_info["is_one_to_one"] = True
+                # Check for conflicts
+                if field.auto_created:
+                    field_info["is_reverse"] = True
+        
+        hierarchy.append(model_info)
+        
+        # Move to parent
+        if meta.parents:
+            parent = list(meta.parents.keys())[0]
+            current = parent
+        else:
+            current = None
+    
+    # Reverse to show from top to bottom
+    hierarchy.reverse()
+    
+    return {
+        "model_name": model_class.__name__,
+        "app_label": model_class._meta.app_label,
+        "hierarchy": hierarchy,
+        "depth": len(hierarchy),
+        "has_parent_link": any("parent_link_field" in level for level in hierarchy),
+        "parent_link_fields": [level.get("parent_link_field") 
+                               for level in hierarchy if "parent_link_field" in level],
+    }
+
+
+def _detect_onetoone_conflicts(model_class: Any) -> Dict[str, Any]:
+    """
+    Detect conflicts in OneToOneField relationships for a model.
+    
+    Args:
+        model_class: Django model class to analyze.
+        
+    Returns:
+        Dictionary containing conflict detection results.
+    """
+    conflicts = []
+    one_to_one_fields = []
+    reverse_one_to_one = []
+    
+    # Check forward OneToOneFields
+    for field in model_class._meta.get_fields():
+        if type(field).__name__ == 'OneToOneField':
+            field_info = {
+                "name": field.name,
+                "type": "forward",
+                "related_model": field.related_model.__name__,
+                "related_name": field.related_query_name(),
+                "auto_created": field.auto_created,
+                "null": field.null,
+                "blank": field.blank,
+            }
+            
+            if field.auto_created:
+                field_info["is_reverse"] = True
+                reverse_one_to_one.append(field_info)
+            else:
+                one_to_one_fields.append(field_info)
+    
+    # Check for duplicate related_name (potential conflict)
+    related_names = {}
+    for field in one_to_one_fields:
+        if not field["is_reverse"]:
+            related_name = field["related_name"]
+            if related_name in related_names:
+                conflicts.append({
+                    "type": "duplicate_related_name",
+                    "field": field["name"],
+                    "related_name": related_name,
+                    "conflict_with": related_names[related_name],
+                    "description": f"Multiple OneToOneFields use the same related_name: {related_name}",
+                })
+            else:
+                related_names[related_name] = field["name"]
+    
+    # Check for duplicate column names (potential conflict)
+    column_names = {}
+    for field in one_to_one_fields:
+        if not field["is_reverse"]:
+            column_name = field.get("db_column", field["name"])
+            if column_name in column_names:
+                conflicts.append({
+                    "type": "duplicate_column",
+                    "field": field["name"],
+                    "column": column_name,
+                    "conflict_with": column_names[column_name],
+                    "description": f"Multiple OneToOneFields use the same column name: {column_name}",
+                })
+            else:
+                column_names[column_name] = field["name"]
+    
+    return {
+        "model_name": model_class.__name__,
+        "one_to_one_fields": one_to_one_fields,
+        "reverse_one_to_one_fields": reverse_one_to_one,
+        "total_forward_fields": len(one_to_one_fields),
+        "total_reverse_fields": len(reverse_one_to_one),
+        "conflicts": conflicts,
+        "has_conflicts": len(conflicts) > 0,
+        "conflict_details": [c["description"] for c in conflicts],
+    }
+
