+def _validate_parent_link(model_class: Any) -> Dict[str, Any]:
+    """
+    Validate parent_link field assignments against Django's rules.
+    
+    Django's rules for parent_link:
+    1. Only one parent_link field per model
+    2. parent_link must be a OneToOneField
+    3. parent_link must point to the parent model in the inheritance chain
+    
+    Args:
+        model_class: Django model class to validate.
+        
+    Returns:
+        Dictionary containing validation results.
+    """
+    from django.db.models import OneToOneField
+    
+    validation_results = {
+        "model_name": model_class.__name__,
+        "parent_link_fields": [],
+        "is_valid": True,
+        "errors": [],
+        "warnings": [],
+    }
+    
+    parent_link_fields = []
+    one_to_one_fields = []
+    
+    # Collect all fields
+    for field in model_class._meta.get_fields():
+        if type(field).__name__ == 'OneToOneField':
+            one_to_one_fields.append(field)
+            if hasattr(field, 'parent_link') and field.parent_link:
+                parent_link_fields.append(field)
+    
+    # Rule 1: Only one parent_link field per model
+    if len(parent_link_fields) > 1:
+        validation_results["is_valid"] = False
+        validation_results["errors"].append(
+            f"Model has {len(parent_link_fields)} parent_link fields, but only one is allowed"
+        )
+    elif len(parent_link_fields) == 1:
+        field = parent_link_fields[0]
+        parent_link_info = {
+            "name": field.name,
+            "field_type": type(field).__name__,
+            "is_valid": True,
+            "issues": [],
+        }
+        
+        # Rule 2: parent_link must be a OneToOneField (already checked above)
+        
+        # Rule 3: Check if it points to a parent in the inheritance chain
+        if hasattr(field, 'related_model'):
+            related_model = field.related_model
+            # Check if this model is in the parents
+            parents = list(model_class._meta.parents.keys())
+            if related_model not in parents:
+                parent_link_info["is_valid"] = False
+                parent_link_info["issues"].append(
+                    f"parent_link points to {related_model.__name__}, which is not in the parent chain"
+                )
+                validation_results["is_valid"] = False
+                validation_results["errors"].append(
+                    f"parent_link field '{field.name}' points to {related_model.__name__}, which is not a parent of {model_class.__name__}"
+                )
+        
+        validation_results["parent_link_fields"].append(parent_link_info)
+    
+    # Check for OneToOneField conflicts with parent_link
+    for field in one_to_one_fields:
+        if not hasattr(field, 'parent_link') or not field.parent_link:
+            # Check if this is a OneToOneField to a parent that should be a parent_link
+            if hasattr(field, 'related_model'):
+                related_model = field.related_model
+                parents = list(model_class._meta.parents.keys())
+                if related_model in parents:
+                    # This might be a candidate for parent_link
+                    if not validation_results["parent_link_fields"]:
+                        validation_results["warnings"].append(
+                            f"OneToOneField '{field.name}' references parent {related_model.__name__} "
+                            f"but is not marked as parent_link. Consider adding parent_link=True."
+                        )
+                    else:
+                        # There's already a parent_link, check if this is redundant
+                        existing_pl = validation_results["parent_link_fields"][0]
+                        if existing_pl["name"] != field.name:
+                            validation_results["warnings"].append(
+                                f"Multiple OneToOneFields reference parents: '{field.name}' and '{existing_pl['name']}'. "
+                                f"Only one should be marked as parent_link."
+                            )
+    
+    return validation_results
+
+
+def _generate_full_analysis(model_class: Any) -> Dict[str, Any]:
+    """
+    Generate a comprehensive analysis of a Django model.
+    
+    Args:
+        model_class: Django model class to analyze.
+        
+    Returns:
+        Dictionary containing all analysis results.
+    """
+    inheritance = _analyze_inheritance_hierarchy(model_class)
+    onetoone = _detect_onetoone_conflicts(model_class)
+    parent_link = _validate_parent_link(model_class)
+    
+    return {
+        "model_name": model_class.__name__,
+        "app_label": model_class._meta.app_label,
+        "analysis_summary": {
+            "inheritance_depth": inheritance["depth"],
+            "has_parent_link": inheritance["has_parent_link"],
+            "parent_link_fields_count": len(inheritance["parent_link_fields"]),
+            "one_to_one_fields_count": onetoone["total_forward_fields"],
+            "reverse_one_to_one_count": onetoone["total_reverse_fields"],
+            "has_conflicts": onetoone["has_conflicts"],
+            "conflict_count": len(onetoone["conflicts"]),
+            "parent_link_valid": parent_link["is_valid"],
+            "parent_link_errors": len(parent_link["errors"]),
+            "parent_link_warnings": len(parent_link["warnings"]),
+        },
+        "inheritance_hierarchy": inheritance,
+        "onetoone_analysis": onetoone,
+        "parent_link_validation": parent_link,
+        "overall_valid": parent_link["is_valid"] and not onetoone["has_conflicts"],
+    }
+
+
+def _load_models_from_app(app_label: str) -> List[Any]:
+    """
+    Load all models from a Django app.
+    
+    Args:
+        app_label: Label of the Django app.
+        
+    Returns:
+        List of model classes in the app.
+    """
+    _setup_django()
+    
+    try:
+        from django.apps import apps
+        
+        app = apps.get_app_config(app_label)
+        return list(app.get_models())
+    except Exception as e:
+        raise ValueError(f"Failed to load models from app {app_label}: {e}")
+
+
+def tool_function(
+    model_class_name: Optional[str] = None,
+    model_path: Optional[str] = None,
+    app_label: Optional[str] = None,
+    analysis_type: str = "full",
+    output_format: str = "detailed",
+) -> str:
+    """
+    Main function to analyze Django models.
+    
+    Args:
+        model_class_name: Name of the model class to analyze.
+        model_path: Path to a Python file containing models.
+        app_label: Label of the Django app to analyze.
+        analysis_type: Type of analysis to perform.
+        output_format: Format of the output.
+        
+    Returns:
+        Analysis results as a formatted string.
+    """
+    try:
+        _setup_django()
+        
+        models = []
+        
+        # Load models based on input
+        if model_class_name:
+            model = _load_model_by_name(model_class_name)
+            models = [model]
+        elif model_path:
+            models = _load_models_from_path(model_path)
+        elif app_label:
+            models = _load_models_from_app(app_label)
+        else:
+            return "Error: Must specify either model_class_name, model_path, or app_label"
+        
+        if not models:
+            return "Error: No models found to analyze"
+        
+        results = []
+        for model in models:
+            if analysis_type == "inheritance":
+                analysis = _analyze_inheritance_hierarchy(model)
+            elif analysis_type == "onetoone":
+                analysis = _detect_onetoone_conflicts(model)
+            elif analysis_type == "parent_link":
+                analysis = _validate_parent_link(model)
+            elif analysis_type == "full":
+                analysis = _generate_full_analysis(model)
+            else:
+                analysis = {"error": f"Unknown analysis type: {analysis_type}"}
+            
+            results.append(analysis)
+        
+        # Format output
+        if output_format == "json":
+            import json
+            return json.dumps(results, indent=2, default=str)
+        elif output_format == "text":
+            # Generate text summary
+            summaries = []
+            for result in results:
+                if "analysis_summary" in result:
+                    summary = result["analysis_summary"]
+                    summaries.append(
+                        f"Model: {result.get('model_name', 'Unknown')}\n"
+                        f"  Inheritance depth: {summary.get('inheritance_depth', 'N/A')}\n"
+                        f"  Parent link fields: {summary.get('parent_link_fields_count', 'N/A')}\n"
+                        f"  OneToOne fields: {summary.get('one_to_one_fields_count', 'N/A')}\n"
+                        f"  Conflicts: {summary.get('conflict_count', 0)}\n"
+                        f"  Overall valid: {summary.get('overall_valid', 'N/A')}"
+                    )
+                else:
+                    summaries.append(str(result))
+            return "\n\n".join(summaries)
+        else:  # detailed
+            # Return detailed text format
+            detailed_results = []
+            for result in results:
+                section = []
+                section.append(f"Model Analysis: {result.get('model_name', 'Unknown')}")
+                section.append("=" * 60)
+                
+                if "analysis_summary" in result:
+                    summary = result["analysis_summary"]
+                    section.append("\nSummary:")
+                    section.append("-" * 40)
+                    for key, value in summary.items():
+                        section.append(f"  {key}: {value}")
+                
+                if "inheritance_hierarchy" in result:
+                    hierarchy = result["inheritance_hierarchy"]
+                    section.append("\nInheritance Hierarchy:")
+                    section.append("-" * 40)
+                    for level in hierarchy.get("hierarchy", []):
+                        section.append(f"  - {level['model_name']} (app: {level['app_label']})")
+                        if level.get("abstract"):
+                            section.append("    (abstract)")
+                
+                if "onetoone_analysis" in result:
+                    onetoone = result["onetoone_analysis"]
+                    section.append("\nOneToOne Field Analysis:")
+                    section.append("-" * 40)
+                    for field in onetoone.get("one_to_one_fields", []):
+                        section.append(f"  - {field['name']}: {field['related_model']}")
+                    for conflict in onetoone.get("conflicts", []):
+                        section.append(f"  ⚠ CONFLICT: {conflict['description']}")
+                
+                if "parent_link_validation" in result:
+                    pl = result["parent_link_validation"]
+                    section.append("\nParent Link Validation:")
+                    section.append("-" * 40)
+                    for field in pl.get("parent_link_fields", []):
+                        section.append(f"  - {field['name']}: {'Valid' if field.get('is_valid') else 'Invalid'}")
+                        for issue in field.get("issues", []):
+                            section.append(f"    ⚠ {issue}")
+                    for error in pl.get("errors", []):
+                        section.append(f"  ❌ ERROR: {error}")
+                    for warning in pl.get("warnings", []):
+                        section.append(f"  ⚠ WARNING: {warning}")
+                
+                detailed_results.append("\n".join(section))
+            
+            return "\n\n".join(detailed_results)
+    
+    except Exception as e:
+        import traceback
+        error_details = f"Error during analysis: {str(e)}\n\n{traceback.format_exc()}"
+        if output_format == "json":
+            import json
+            return json.dumps({"error": error_details}, indent=2)
+        else:
+            return error_details
+
+
+# Convenience functions for direct use
+def analyze_inheritance(model_class_name: Optional[str] = None, 
+                        model_path: Optional[str] = None,
+                        app_label: Optional[str] = None) -> Dict[str, Any]:
+    """Convenience function to analyze inheritance hierarchy."""
+    result = tool_function(
+        model_class_name=model_class_name,
+        model_path=model_path,
+        app_label=app_label,
+        analysis_type="inheritance",
+        output_format="json"
+    )
+    import json
+    return json.loads(result)
+
+
+def detect_onetoone_conflicts(model_class_name: Optional[str] = None,
+                               model_path: Optional[str] = None,
+                               app_label: Optional[str] = None) -> Dict[str, Any]:
+    """Convenience function to detect OneToOneField conflicts."""
+    result = tool_function(
+        model_class_name=model_class_name,
+        model_path=model_path,
+        app_label=app_label,
+        analysis_type="onetoone",
+        output_format="json"
+    )
+    import json
+    return json.loads(result)
+
+
+def validate_parent_link(model_class_name: Optional[str] = None,
+                         model_path: Optional[str] = None,
+                         app_label: Optional[str] = None) -> Dict[str, Any]:
+    """Convenience function to validate parent_link fields."""
+    result = tool_function(
+        model_class_name=model_class_name,
+        model_path=model_path,
+        app_label=app_label,
+        analysis_type="parent_link",
+        output_format="json"
+    )
+    import json
+    return json.loads(result)
+
+
+def analyze_model(model_class_name: Optional[str] = None,
+                  model_path: Optional[str] = None,
+                  app_label: Optional[str] = None) -> Dict[str, Any]:
+    """Convenience function to perform full model analysis."""
+    result = tool_function(
+        model_class_name=model_class_name,
+        model_path=model_path,
+        app_label=app_label,
+        analysis_type="full",
+        output_format="json"
+    )
+    import json
+    return json.loads(result)
+
