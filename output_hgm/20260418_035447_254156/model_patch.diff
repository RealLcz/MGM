+        print(json.dumps(result, indent=2))
+    elif command == "validate-parentlink" and len(sys.argv) > 2:
+        result = validate_parent_link(model_class_name=sys.argv[2])
+        print(json.dumps(result, indent=2))
+    elif command == "analyze-model" and len(sys.argv) > 2:
+        result = analyze_model(model_class_name=sys.argv[2])
+        print(json.dumps(result, indent=2))
+    else:
+        print(f"Unknown command or missing arguments: {command}")
+        sys.exit(1)
