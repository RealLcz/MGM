+# This file is adapted from https://github.com/jennyzzt/dgm.
+
+import ast
+import json
+import os
+
+
+def tool_info():
+    """Tool info for parameter defaults analysis."""
+    return {
+        "name": "parameter_defaults_analysis",
+        "description": """Analyze function signatures to compute expected defaults using Python's official semantics.
+In Python, defaults are assigned from the end of the full parameter list.
+This tool helps debug signature parsing logic by comparing expected vs actual defaults.
+Can be invoked with signature_str parameter to analyze a function signature.
+Optionally provide expected_defaults and target_file for validation against actual code.
+Returns a structured report with parameter_index, name, expected_default, actual_default, and status.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "signature_str": {
+                    "type": "string",
+                    "description": "String representation of the function signature to analyze (e.g., '(a, b=1, c=2)')"
+                },
+                "expected_defaults": {
+                    "type": "object",
+                    "description": "Optional: Expected default values as a dictionary mapping parameter names to values."
+                },
+                "target_file": {
+                    "type": "string",
+                    "description": "Optional: Path to a file containing the function for actual default extraction and validation."
+                }
+            },
+            "required": ["signature_str"],
+        },
+    }
+
+
+def analyze_parameter_defaults(signature_str, target_file=None):
+    """
+    Analyze a function signature and compute expected defaults using Python's official semantics.
+    
+    In Python, defaults are assigned from the end of the full parameter list.
+    This function parses the signature and returns a structured report showing:
+    - parameter_index: The position of the parameter in the full parameter list
+    - name: The parameter name
+    - expected_default: The expected default value based on Python's semantics
+    - actual_default: The actual default value (if code is available)
+    - status: 'correct', 'incorrect', or 'unknown' (if code unavailable)
+    
+    Args:
+        signature_str: A string representation of the function signature
+        target_file: Optional path to a file containing the function for actual default extraction
+        
+    Returns:
+        dict: A structured report with parameter analysis
+    """
+    result = {
+        'signature': signature_str,
+        'parameters': []
+    }
+    
+    # Try to parse the signature to get parameter names
+    try:
+        # Try to parse as a function definition
+        code = f"def temp_func{signature_str}: pass"
+        tree = ast.parse(code)
+        func_node = tree.body[0]
+        args = func_node.args
+        
+        # Build the full parameter list considering positional-only args
+        all_params = []
+        
+        # Positional-only parameters (before /)
+        for i, arg in enumerate(args.posonlyargs):
+            all_params.append({
+                'index': i,
+                'name': arg.arg,
+                'kind': 'posonly'
+            })
+        
+        # Regular positional-or-keyword parameters
+        for i, arg in enumerate(args.args, start=len(args.posonlyargs)):
+            all_params.append({
+                'index': i,
+                'name': arg.arg,
+                'kind': 'positional_or_keyword'
+            })
+        
+        # *args
+        if args.vararg:
+            all_params.append({
+                'index': len(all_params),
+                'name': args.vararg.arg,
+                'kind': 'vararg'
+            })
+        
+        # Keyword-only parameters (after *)
+        for i, arg in enumerate(args.kwonlyargs, start=len(all_params)):
+            all_params.append({
+                'index': i,
+                'name': arg.arg,
+                'kind': 'keyword_only'
+            })
+        
+        # **kwargs
+        if args.kwarg:
+            all_params.append({
+                'index': len(all_params),
+                'name': args.kwarg.arg,
+                'kind': 'varkwarg'
+            })
+        
+        # Compute expected defaults
+        # In Python, defaults are assigned from the end of the full parameter list
+        # The number of defaults is len(args.defaults)
+        # They apply to the last N parameters (excluding *args and **kwargs)
+        
+        # Count parameters that can have defaults (positional-only, positional-or-keyword, keyword-only)
+        defaultable_params = [p for p in all_params if p['kind'] in ['posonly', 'positional_or_keyword', 'keyword_only']]
+        
+        # The defaults are assigned from the end
+        num_defaults = len(args.defaults)
+        start_idx = len(defaultable_params) - num_defaults
+        
+        # Map defaults to parameters
+        default_map = {}
+        for i, param in enumerate(defaultable_params):
+            if i >= start_idx:
+                default_idx = i - start_idx
+                default_map[param['name']] = args.defaults[default_idx]
+            else:
+                default_map[param['name']] = None
+        
+        # Get actual defaults from code if available
+        actual_defaults = {}
+        if target_file and os.path.exists(target_file):
+            try:
+                with open(target_file, 'r') as f:
+                    content = f.read()
+                tree = ast.parse(content)
+                
+                # Find the function
+                for node in ast.walk(tree):
+                    if isinstance(node, ast.FunctionDef) and node.name == 'temp_func':
+                        func_args = node.args
+                        
+                        # Rebuild the default mapping from the actual code
+                        defaultable_from_code = []
+                        for i, arg in enumerate(func_args.posonlyargs):
+                            defaultable_from_code.append(arg.arg)
+                        for i, arg in enumerate(func_args.args, start=len(func_args.posonlyargs)):
+                            defaultable_from_code.append(arg.arg)
+                        for i, arg in enumerate(func_args.kwonlyargs, start=len(defaultable_from_code)):
+                            defaultable_from_code.append(arg.arg)
+                        
+                        num_from_code = len(func_args.defaults)
+                        start_from_code = len(defaultable_from_code) - num_from_code
+                        
+                        for i, param_name in enumerate(defaultable_from_code):
+                            if i >= start_from_code:
+                                default_idx = i - start_from_code
+                                actual_defaults[param_name] = func_args.defaults[default_idx]
+            except Exception:
+                pass
+        
+        # Build the result
+        for param in all_params:
+            param_result = {
+                'parameter_index': param['index'],
+                'name': param['name'],
+                'kind': param['kind'],
+                'expected_default': None
+            }
+            
+            if param['name'] in default_map:
+                default_value = default_map[param['name']]
+                if default_value is not None:
+                    # Convert AST constant to Python value
+                    if hasattr(default_value, 'value'):
+                        param_result['expected_default'] = default_value.value
+                    else:
+                        param_result['expected_default'] = ast.unparse(default_value) if hasattr(ast, 'unparse') else str(default_value)
+                else:
+                    param_result['expected_default'] = None
+            
+            # Add actual default if available
+            if param['name'] in actual_defaults:
+                actual_value = actual_defaults[param['name']]
+                if hasattr(actual_value, 'value'):
+                    param_result['actual_default'] = actual_value.value
+                else:
+                    param_result['actual_default'] = ast.unparse(actual_value) if hasattr(ast, 'unparse') else str(actual_value)
+                
+                # Determine status
+                if param_result.get('actual_default') == param_result['expected_default']:
+                    param_result['status'] = 'correct'
+                else:
+                    param_result['status'] = 'incorrect'
+            else:
+                param_result['status'] = 'unknown'
+            
+            result['parameters'].append(param_result)
+        
+        result['success'] = True
+        result['error'] = None
+        
+    except SyntaxError as e:
+        result['success'] = False
+        result['error'] = f"Syntax error in signature: {e}"
+    except Exception as e:
+        result['success'] = False
+        result['error'] = f"Error analyzing signature: {e}"
+    
+    return result
+
+
+def tool_function(signature_str, expected_defaults=None, target_file=None):
+    """
+    Tool function for parameter defaults analysis.
+    
+    Args:
+        signature_str: String representation of the function signature
+        expected_defaults: Optional dictionary of expected default values
+        target_file: Optional path to file containing the function
+        
+    Returns:
+        str: JSON-formatted string with analysis results
+    """
+    try:
+        result = analyze_parameter_defaults(signature_str, target_file)
+        
+        if expected_defaults:
+            result['expected_defaults_provided'] = expected_defaults
+            
+            # Validate against expected defaults
+            validation = []
+            for param in result['parameters']:
+                param_name = param['name']
+                if param_name in expected_defaults:
+                    expected_val = expected_defaults[param_name]
+                    actual_val = param.get('actual_default', param.get('expected_default'))
+                    
+                    if actual_val == expected_val:
+                        validation.append({
+                            'parameter': param_name,
+                            'status': 'matches',
+                            'expected': expected_val,
+                            'actual': actual_val
+                        })
+                    else:
+                        validation.append({
+                            'parameter': param_name,
+                            'status': 'mismatch',
+                            'expected': expected_val,
+                            'actual': actual_val
+                        })
+            
+            result['validation'] = validation
+        
+        return json.dumps(result, indent=2, default=str)
+    
+    except Exception as e:
+        import traceback
+        error_info = {
+            'error': str(e),
+            'traceback': traceback.format_exc()
+        }
+        return json.dumps(error_info, indent=2, default=str)
+
+
+if __name__ == '__main__':
+    import sys
+    
+    # Example usage
+    signature = "(a, b=1, c=2)"
+    result = tool_function(signature_str=signature)
+    print(result)
