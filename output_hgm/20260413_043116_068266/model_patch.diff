+                    actual_val = param.get('actual_default', param.get('expected_default'))
+                    
+                    if actual_val == expected_val:
+                        validation.append({
+                            'parameter': param_name,
+                            'status': 'matches',
+                            'expected': expected_val,
+                            'actual': actual_val
+                        })
+                    else:
+                        validation.append({
+                            'parameter': param_name,
+                            'status': 'mismatch',
+                            'expected': expected_val,
