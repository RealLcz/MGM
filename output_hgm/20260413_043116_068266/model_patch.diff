+    result = {
+        'signature': signature_str,
+        'parameters': []
+    }
+    
+    # Try to parse the signature to get parameter names
+    try:
+        # Try to parse as a function definition
+        code = f"def temp_func{signature_str}: pass"
+        tree = ast.parse(code)
+        func_node = tree.body[0]
+        args = func_node.args
+        
+        # Build the full parameter list considering positional-only args
+        all_params = []
+        
+        # Positional-only parameters (before /)
+        for i, arg in enumerate(args.posonlyargs):
+            all_params.append({
+                'index': i,
+                'name': arg.arg,
+                'kind': 'posonly'
+            })
+        
+        # Regular positional-or-keyword parameters
+        for i, arg in enumerate(args.args, start=len(args.posonlyargs)):
+            all_params.append({
+                'index': i,
+                'name': arg.arg,
+                'kind': 'positional_or_keyword'
+            })
+        
+        # *args
+        if args.vararg:
+            all_params.append({
+                'index': len(all_params),
+                'name': args.vararg.arg,
+                'kind': 'vararg'
+            })
+        
+        # Keyword-only parameters (after *)
+        for i, arg in enumerate(args.kwonlyargs, start=len(all_params)):
+            all_params.append({
+                'index': i,
+                'name': arg.arg,
+                'kind': 'keyword_only'
+            })
+        
+        # **kwargs
+        if args.kwarg:
+            all_params.append({
+                'index': len(all_params),
+                'name': args.kwarg.arg,
+                'kind': 'varkwarg'
+            })
+        
+        # Compute expected defaults
+        # In Python, defaults are assigned from the end of the full parameter list
+        # The number of defaults is len(args.defaults)
+        # They apply to the last N parameters (excluding *args and **kwargs)
+        
+        # Count parameters that can have defaults (positional-only, positional-or-keyword, keyword-only)
+        defaultable_params = [p for p in all_params if p['kind'] in ['posonly', 'positional_or_keyword', 'keyword_only']]
+        
+        # The defaults are assigned from the end
+        num_defaults = len(args.defaults)
+        start_idx = len(defaultable_params) - num_defaults
+        
+        # Map defaults to parameters
+        default_map = {}
+        for i, param in enumerate(defaultable_params):
+            if i >= start_idx:
+                default_idx = i - start_idx
+                default_map[param['name']] = args.defaults[default_idx]
+            else:
+                default_map[param['name']] = None
+        
+        # Get actual defaults from code if available
+        actual_defaults = {}
