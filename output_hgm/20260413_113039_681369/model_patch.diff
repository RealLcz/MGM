+def analyze_test_for_validation(test_file, test_function=None, expected_behavior=None):
+    """
+    Analyze a test file to understand what it's testing and how well it validates behavior.
+    
+    Args:
+        test_file: Path to the test file
+        test_function: Optional specific test function name
+        expected_behavior: Expected behavior description
+    
+    Returns:
+        dict: Analysis of the test's validation capabilities
+    """
+    analysis = {
+        'has_assertions': False,
+        'assertion_count': 0,
+        'captures_expected_behavior': False,
+        'coverage_gaps': [],
+        'strengths': [],
+        'weaknesses': []
+    }
+    
+    try:
+        with open(test_file, 'r') as f:
+            content = f.read()
+        
+        tree = ast.parse(content)
+        
+        # Find the specific test function if requested
+        test_nodes = []
+        for node in ast.walk(tree):
+            if isinstance(node, ast.FunctionDef):
+                if test_function and node.name == test_function:
+                    test_nodes.append(node)
+                    break
+                elif node.name.startswith('test_') and not test_function:
+                    test_nodes.append(node)
+        
+        if not test_nodes:
+            analysis['warning'] = "No test functions found matching criteria"
+            return analysis
+        
+        # Analyze each test function
+        for test_node in test_nodes:
+            # Count assertions
+            assertion_count = 0
+            for child in ast.walk(test_node):
+                if isinstance(child, (ast.Assert, ast.Call)):
+                    if isinstance(child, ast.Call):
+                        if isinstance(child.func, ast.Attribute):
+                            if 'assert' in child.func.attr.lower():
+                                assertion_count += 1
+                    elif isinstance(child, ast.Assert):
+                        assertion_count += 1
+            
+            analysis['assertion_count'] += assertion_count
+            
+            if assertion_count > 0:
+                analysis['has_assertions'] = True
+            
+            # Check if test has clear expected behavior
+            docstring = ast.get_docstring(test_node)
+            if docstring:
+                if expected_behavior and expected_behavior.lower() in docstring.lower():
+                    analysis['captures_expected_behavior'] = True
+                    analysis['strengths'].append("Test docstring captures expected behavior")
+                else:
+                    analysis['coverage_gaps'].append("Test docstring doesn't match expected behavior")
+            
+            # Check for validation patterns
+            test_source = ast.unparse(test_node) if hasattr(ast, 'unparse') else content
+            if 'assert' in test_source:
+                analysis['strengths'].append("Test includes assertions")
+            if 'assertEqual' in test_source or 'assertEqual' in test_source:
+                analysis['strengths'].append("Test uses specific assertion methods")
+            if 'expected' in test_source.lower() or 'expected' in test_source.lower():
+                analysis['strengths'].append("Test references expected values")
+            
+            # Check for weaknesses
+            if assertion_count == 0:
+                analysis['weaknesses'].append("No assertions found in test")
+            if not docstring:
+                analysis['weaknesses'].append("Test lacks docstring explaining expected behavior")
+            
+            # Check if test has setup/teardown
+            if 'setup' in test_source.lower() or 'teardown' in test_source.lower():
+                analysis['strengths'].append("Test has setup/teardown")
+            else:
+                analysis['coverage_gaps'].append("Test lacks setup/teardown methods")
+        
+        # General analysis
+        if analysis['assertion_count'] == 0:
+            analysis['coverage_gaps'].append("Test has no assertions - cannot validate behavior")
+        
+        if expected_behavior and not analysis['captures_expected_behavior']:
+            analysis['coverage_gaps'].append(f"Expected behavior '{expected_behavior}' not explicitly validated")
+        
+    except Exception as e:
+        analysis['error'] = str(e)
+    
+    return analysis
