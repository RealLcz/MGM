+# This file is adapted from https://github.com/jennyzzt/dgm.
+
+import tempfile
+from pathlib import Path
+
+import pytest
+
+from tools.test_validator import (
+    find_test_files,
+    format_test_results,
+    parse_pytest_output,
+    parse_test_file,
+    tool_function,
+)
+
+
+class TestTestValidatorTool:
+    """Tests for the test_validator tool."""
+
+    def test_tool_info_exists(self):
+        """Test that tool_info function exists and returns correct structure."""
+        from tools.test_validator import tool_info
+
+        info = tool_info()
+        assert "name" in info
+        assert "description" in info
+        assert "input_schema" in info
+        assert info["name"] == "test_validator"
+
+    def test_parse_test_file_pytest(self):
+        """Test parsing a pytest test file."""
+        code = """
+import pytest
+
+def test_simple():
+    assert 1 + 1 == 2
+
+class TestClass:
+    def test_method(self):
+        assert True
+"""
+        with tempfile.NamedTemporaryFile(mode="w", suffix=".py", delete=False) as f:
+            f.write(code)
+            temp_file = f.name
+
+        try:
+            result = parse_test_file(temp_file)
+            assert result["framework"] == "pytest"
+            assert result["has_pytest_imports"] is True
+            assert len(result["test_functions"]) == 2
+            assert result["test_functions"][0]["name"] == "test_simple"
+            assert len(result["test_classes"]) == 1
+            assert result["test_classes"][0]["name"] == "TestClass"
+        finally:
+            Path(temp_file).unlink()
+
+    def test_parse_test_file_unittest(self):
+        """Test parsing a unittest test file."""
+        code = """
+import unittest
+
+class TestExample(unittest.TestCase):
+    def test_something(self):
+        self.assertTrue(True)
+"""
+        with tempfile.NamedTemporaryFile(mode="w", suffix=".py", delete=False) as f:
+            f.write(code)
+            temp_file = f.name
+
+        try:
+            result = parse_test_file(temp_file)
+            assert result["framework"] == "unittest"
+            assert result["has_unittest_imports"] is True
+            assert len(result["test_classes"]) == 1
+            assert result["test_classes"][0]["name"] == "TestExample"
+        finally:
+            Path(temp_file).unlink()
+
+    def test_find_test_files(self):
+        """Test finding test files in a directory."""
+        with tempfile.TemporaryDirectory() as tmpdir:
+            # Create some test files
+            Path(tmpdir, "test_example.py").write_text("def test_one(): pass")
+            Path(tmpdir, "example_test.py").write_text("def test_two(): pass")
+            Path(tmpdir, "non_test.py").write_text("def some_func(): pass")
+
+            result = find_test_files(tmpdir)
+            assert any("test_example.py" in str(r) for r in result)
+            assert any("example_test.py" in str(r) for r in result)
+            # non_test.py should not be in results
+            assert not any("non_test.py" in str(r) for r in result)
+
+    def test_find_test_files_no_tests(self):
+        """Test finding test files when none exist."""
+        with tempfile.TemporaryDirectory() as tmpdir:
+            Path(tmpdir, "regular.py").write_text("x = 1")
+
+            result = find_test_files(tmpdir)
+            assert len(result) == 0
+
+    def test_parse_pytest_output_passed(self):
+        """Test parsing pytest output with passed tests."""
